        "exact_expected_user_answer_required": false,
        "semantically_equivalent_decomposition_allowed": true
      },
      "learning_fork_value": {
        "review_prompt": "When the relevant interaction occurred, pass only when the surfaced agent-owned technical fork was genuinely meaningful and worth deliberate user reasoning. For absent interaction, apply the workload-intent recognition and source-grounded meaningful-fork/absence review; no event count supplies a verdict.",
