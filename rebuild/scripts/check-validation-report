#!/usr/bin/env python3
"""Check maintained validation report shape and optional V11 capsule semantics."""

from __future__ import annotations

import argparse
import copy
import json
from pathlib import Path
import re
import shlex
import sys
import tempfile
from typing import Any, Sequence


SECTIONS = (
    "Status",
    "Goal",
    "Accepted decisions being validated",
    "Input repositories and revisions",
    "Environment and tool versions",
    "Candidate approaches",
    "Commands and configuration",
    "Observed results",
    "Coverage and failures",
    "Performance and resource observations",
    "Privacy and external transmission",
    "Acceptance results",
    "Known limits",
    "Recommended implementation choice",
    "Rejected alternatives and reasons",
    "Reusable primitive decision",
    "Decision revisit trigger status",
    "Follow-up work",
    "Artifacts",
)
REQUIRED_TOOLS = ("python", "git", "cargo", "rustc", "codex")
DEPENDENCY_IDENTITIES = ("cargo_lock", "workspace_manifest", "fixture_manifest")
SHA256 = re.compile(r"[0-9a-f]{64}")
HEAD = re.compile(r"[0-9a-f]{40}")


def report_sections(text: str) -> dict[str, str]:
    lines = text.splitlines()
    headings = {
        line.removeprefix("## "): index
        for index, line in enumerate(lines)
        if line.startswith("## ")
    }
    result: dict[str, str] = {}
    for section in SECTIONS:
        start = headings.get(section)
        if start is None:
            continue
        end = next(
            (index for index in range(start + 1, len(lines)) if lines[index].startswith("## ")),
            len(lines),
        )
        result[section] = "\n".join(lines[start + 1 : end])
    return result


def check_shape_text(text: str) -> list[str]:
    errors: list[str] = []
    lines = text.splitlines()
    if not lines or not re.fullmatch(r"# V\d{2} — .+", lines[0]):
        errors.append("first line must be '# VNN — <title>'")
    positions: list[int] = []
    for section in SECTIONS:
        heading = f"## {section}"
        matching = [index for index, line in enumerate(lines) if line == heading]
        if len(matching) != 1:
            errors.append(f"expected exactly one heading: {heading}")
            continue
        positions.append(matching[0])
        next_nonblank = next((line for line in lines[matching[0] + 1 :] if line.strip()), "")
        if not next_nonblank or next_nonblank.startswith("## "):
            errors.append(f"section has no content: {heading}")
    if positions != sorted(positions):
        errors.append("required headings are out of order")
    return errors


def check(path: Path) -> list[str]:
    return check_shape_text(path.read_text(encoding="utf-8"))


def mapping(value: Any, label: str, errors: list[str]) -> dict[str, Any]:
    if not isinstance(value, dict):
        errors.append(f"capsule field must be an object: {label}")
        return {}
    return value


def sequence(value: Any, label: str, errors: list[str]) -> list[Any]:
    if not isinstance(value, list):
        errors.append(f"capsule field must be an array: {label}")
        return []
    return value


def nonempty_string(value: Any, label: str, errors: list[str]) -> str:
    if not isinstance(value, str) or not value:
        errors.append(f"capsule field must be a nonempty string: {label}")
        return ""
    return value


def digest(value: Any, label: str, errors: list[str], pattern: re.Pattern[str] = SHA256) -> str:
    text = nonempty_string(value, label, errors)
    if text and not pattern.fullmatch(text):
        errors.append(f"capsule field has invalid digest/identity syntax: {label}")
    return text


def capsule_contract_errors(capsule: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    if capsule.get("kind") != "validation_handoff_capsule":
        errors.append("capsule kind must be validation_handoff_capsule")
    digest(capsule.get("validated_candidate_head"), "validated_candidate_head", errors, HEAD)

    environment = mapping(capsule.get("execution_environment"), "execution_environment", errors)
    platform_value = mapping(environment.get("platform"), "execution_environment.platform", errors)
    for key in ("operating_system", "release", "platform_version", "machine", "architecture"):
        nonempty_string(platform_value.get(key), f"execution_environment.platform.{key}", errors)
    runtime = mapping(environment.get("python_runtime"), "execution_environment.python_runtime", errors)
    for key in ("implementation", "version", "executable_basename"):
        nonempty_string(runtime.get(key), f"execution_environment.python_runtime.{key}", errors)
    tools = mapping(environment.get("tools"), "execution_environment.tools", errors)
    for name in REQUIRED_TOOLS:
        tool = mapping(tools.get(name), f"execution_environment.tools.{name}", errors)
        argv = sequence(tool.get("argv"), f"execution_environment.tools.{name}.argv", errors)
        if not argv or not all(isinstance(value, str) and value for value in argv):
            errors.append(f"capsule tool probe argv is incomplete: {name}")
        status = tool.get("status")
        if status not in {"available", "unavailable", "error"}:
            errors.append(f"capsule tool probe status is invalid: {name}")
        if status == "available":
            nonempty_string(tool.get("version"), f"execution_environment.tools.{name}.version", errors)
        elif tool.get("version") is not None or not tool.get("error"):
            errors.append(f"capsule tool probe must preserve explicit unavailable/error state: {name}")

    dependencies = mapping(capsule.get("dependency_snapshot"), "dependency_snapshot", errors)
    dependency_head = digest(dependencies.get("candidate_head"), "dependency_snapshot.candidate_head", errors, HEAD)
    if dependency_head and dependency_head != capsule.get("validated_candidate_head"):
        errors.append("capsule dependency candidate HEAD does not match validated_candidate_head")
    for name in DEPENDENCY_IDENTITIES:
        identity = mapping(dependencies.get(name), f"dependency_snapshot.{name}", errors)
        nonempty_string(identity.get("path"), f"dependency_snapshot.{name}.path", errors)
        if identity.get("status") != "available":
            errors.append(f"capsule dependency identity is not available: {name}")
        digest(identity.get("sha256"), f"dependency_snapshot.{name}.sha256", errors)

    final = mapping(capsule.get("final_aggregate"), "final_aggregate", errors)
    nonempty_string(final.get("status"), "final_aggregate.status", errors)
    if not isinstance(final.get("command_count"), int) or final.get("command_count", 0) <= 0:
        errors.append("capsule final_aggregate.command_count must be positive")
    if not isinstance(final.get("failure_count"), int):
        errors.append("capsule final_aggregate.failure_count must be an integer")
    commands = sequence(final.get("commands"), "final_aggregate.commands", errors)
    if len(commands) != final.get("command_count"):
        errors.append("capsule final command count does not match commands")
    for index, value in enumerate(commands):
        command = mapping(value, f"final_aggregate.commands[{index}]", errors)
        nonempty_string(command.get("name"), f"final_aggregate.commands[{index}].name", errors)
        argv = sequence(command.get("argv"), f"final_aggregate.commands[{index}].argv", errors)
        if not argv or not all(isinstance(part, str) and part for part in argv):
            errors.append(f"capsule final command argv is incomplete: index {index}")
        nonempty_string(command.get("outcome"), f"final_aggregate.commands[{index}].outcome", errors)
        if not isinstance(command.get("exit_code"), int):
            errors.append(f"capsule final command exit_code must be an integer: index {index}")
        if not isinstance(command.get("duration_ms"), (int, float)):
            errors.append(f"capsule final command duration_ms must be numeric: index {index}")
        if "termination" not in command:
            errors.append(f"capsule final command termination is missing: index {index}")
    digest(capsule.get("final_summary_sha256"), "final_summary_sha256", errors)

    configuration = mapping(capsule.get("gate_configuration"), "gate_configuration", errors)
    gate_argv = sequence(configuration.get("argv"), "gate_configuration.argv", errors)
    if not gate_argv or not all(isinstance(value, str) and value for value in gate_argv):
        errors.append("capsule gate_configuration.argv is incomplete")
    if configuration.get("argv_status") != "complete":
        errors.append("capsule gate_configuration.argv_status must be complete")
    nonempty_string(
        configuration.get("technical_external_network_assertion"),
        "gate_configuration.technical_external_network_assertion",
        errors,
    )
    nonempty_string(
        configuration.get("authorization_assertion_id"),
        "gate_configuration.authorization_assertion_id",
        errors,
    )
    transmission = mapping(configuration.get("external_transmission"), "gate_configuration.external_transmission", errors)
    for key in ("destination", "purpose", "source_scope", "authorization_assertion"):
        nonempty_string(transmission.get(key), f"gate_configuration.external_transmission.{key}", errors)
    scopes = sequence(transmission.get("scope"), "gate_configuration.external_transmission.scope", errors)
    if not scopes or not all(isinstance(value, str) and value for value in scopes):
        errors.append("capsule external transmission target scope is incomplete")
    flow = mapping(configuration.get("same_session_artifact_flow"), "gate_configuration.same_session_artifact_flow", errors)
    for key in (
        "final_artifact_produced_by_gate",
        "v11_preflight_consumed_same_gate_final_artifact",
        "official_v11_consumed_same_gate_final_artifact",
    ):
        if flow.get(key) is not True:
            errors.append(f"capsule successful V11 handoff requires true artifact-flow fact: {key}")

    official = mapping(capsule.get("official_v11"), "official_v11", errors)
    nonempty_string(official.get("status"), "official_v11.status", errors)
    digest(official.get("result_sha256"), "official_v11.result_sha256", errors)
    if not isinstance(official.get("required_step_count"), int):
        errors.append("capsule official_v11.required_step_count must be an integer")
    counts = mapping(official.get("status_counts"), "official_v11.status_counts", errors)
    if not counts or not all(isinstance(key, str) and isinstance(value, int) for key, value in counts.items()):
        errors.append("capsule official_v11.status_counts is incomplete")
    if not isinstance(official.get("phase_8_ready"), bool):
        errors.append("capsule official_v11.phase_8_ready must be a boolean")

    identities = mapping(capsule.get("required_identities"), "required_identities", errors)
    identity_head = digest(identities.get("candidate_head"), "required_identities.candidate_head", errors, HEAD)
    if identity_head and identity_head != capsule.get("validated_candidate_head"):
        errors.append("capsule required identity HEAD does not match validated_candidate_head")
    fixtures = sequence(identities.get("fixtures"), "required_identities.fixtures", errors)
    if not fixtures:
        errors.append("capsule required fixture identities are empty")
    for index, value in enumerate(fixtures):
        fixture = mapping(value, f"required_identities.fixtures[{index}]", errors)
        nonempty_string(fixture.get("id"), f"required_identities.fixtures[{index}].id", errors)
        nonempty_string(
            fixture.get("validation_id"),
            f"required_identities.fixtures[{index}].validation_id",
            errors,
        )
        digest(
            fixture.get("content_sha256"),
            f"required_identities.fixtures[{index}].content_sha256",
            errors,
        )

    audit = mapping(capsule.get("credential_retention_audit"), "credential_retention_audit", errors)
    nonempty_string(audit.get("status"), "credential_retention_audit.status", errors)
    for key in ("auth_named_file_count", "credential_content_match_count", "scan_error_count"):
        if not isinstance(audit.get(key), int):
            errors.append(f"capsule credential audit count must be an integer: {key}")
    if not isinstance(capsule.get("phase_8_ready"), bool):
        errors.append("capsule phase_8_ready must be a boolean")
    triggers = sequence(
        capsule.get("active_decision_revisit_triggers"),
        "active_decision_revisit_triggers",
        errors,
    )
    if not all(isinstance(value, str) and value for value in triggers):
        errors.append("capsule active Decision revisit triggers must be strings")
    nonempty_string(
        capsule.get("decision_revisit_trigger_assessment"),
        "decision_revisit_trigger_assessment",
        errors,
    )
    outcomes = sequence(capsule.get("authenticated_codex_outcomes"), "authenticated_codex_outcomes", errors)
    if not outcomes:
        errors.append("capsule authenticated Codex outcomes are empty")
    for index, value in enumerate(outcomes):
        outcome = mapping(value, f"authenticated_codex_outcomes[{index}]", errors)
        for key in ("target", "status", "classification"):
            nonempty_string(
                outcome.get(key),
                f"authenticated_codex_outcomes[{index}].{key}",
                errors,
            )
    return errors


def scalar_text(value: Any) -> str:
    if isinstance(value, str):
        return value
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def require(section: str, section_name: str, label: str, value: Any, errors: list[str]) -> None:
    rendered = scalar_text(value)
    if label not in section or rendered not in section:
        errors.append(
            f"capsule-backed report section '{section_name}' must record {label} = {rendered}"
        )


def check_capsule_semantics(text: str, capsule: dict[str, Any]) -> list[str]:
    errors = capsule_contract_errors(capsule)
    if errors:
        return errors
    sections = report_sections(text)
    inputs = sections.get("Input repositories and revisions", "")
    environment_section = sections.get("Environment and tool versions", "")
    commands_section = sections.get("Commands and configuration", "")
    observed = sections.get("Observed results", "")
    coverage = sections.get("Coverage and failures", "")
    privacy = sections.get("Privacy and external transmission", "")
    acceptance = sections.get("Acceptance results", "")
    revisit = sections.get("Decision revisit trigger status", "")

    head = capsule["validated_candidate_head"]
    require(inputs, "Input repositories and revisions", "validated_candidate_head", head, errors)
    dependencies = capsule["dependency_snapshot"]
    for name in DEPENDENCY_IDENTITIES:
        identity = dependencies[name]
        require(inputs, "Input repositories and revisions", name, identity["path"], errors)
        require(inputs, "Input repositories and revisions", f"{name}.sha256", identity["sha256"], errors)
    fixtures = capsule.get("required_identities", {}).get("fixtures", [])
    for fixture in fixtures:
        require(inputs, "Input repositories and revisions", "fixture.id", fixture.get("id"), errors)
        require(inputs, "Input repositories and revisions", "fixture.content_sha256", fixture.get("content_sha256"), errors)

    environment = capsule["execution_environment"]
    for key, value in environment["platform"].items():
        require(environment_section, "Environment and tool versions", f"platform.{key}", value, errors)
    for key, value in environment["python_runtime"].items():
        require(environment_section, "Environment and tool versions", f"python_runtime.{key}", value, errors)
    for name in REQUIRED_TOOLS:
        tool = environment["tools"][name]
        require(environment_section, "Environment and tool versions", f"tools.{name}.status", tool["status"], errors)
        require(
            environment_section,
            "Environment and tool versions",
            f"tools.{name}.version" if tool["status"] == "available" else f"tools.{name}.error",
            tool["version"] if tool["status"] == "available" else tool["error"],
            errors,
        )

    configuration = capsule["gate_configuration"]
    require(commands_section, "Commands and configuration", "gate_configuration.argv", shlex.join(configuration["argv"]), errors)
    require(
        commands_section,
        "Commands and configuration",
        "technical_external_network_assertion",
        configuration["technical_external_network_assertion"],
        errors,
    )
    require(
        commands_section,
        "Commands and configuration",
        "authorization_assertion_id",
        configuration["authorization_assertion_id"],
        errors,
    )
    for key, value in configuration["same_session_artifact_flow"].items():
        require(commands_section, "Commands and configuration", key, value, errors)
    final = capsule["final_aggregate"]
    for key in ("status", "command_count", "failure_count"):
        require(commands_section, "Commands and configuration", f"final_aggregate.{key}", final[key], errors)
    for command in final["commands"]:
        label = f"final_command.{command['name']}"
        require(commands_section, "Commands and configuration", label, shlex.join(command["argv"]), errors)
        for key in ("outcome", "exit_code", "termination", "duration_ms"):
            require(commands_section, "Commands and configuration", f"{label}.{key}", command[key], errors)
    require(commands_section, "Commands and configuration", "final_summary_sha256", capsule["final_summary_sha256"], errors)

    transmission = configuration["external_transmission"]
    for key in ("destination", "purpose", "source_scope"):
        require(privacy, "Privacy and external transmission", f"external_transmission.{key}", transmission[key], errors)
    for target in transmission["scope"]:
        require(privacy, "Privacy and external transmission", "external_transmission.scope", target, errors)
    require(
        privacy,
        "Privacy and external transmission",
        "external_transmission.authorization_assertion",
        transmission["authorization_assertion"],
        errors,
    )
    audit = capsule["credential_retention_audit"]
    for key, value in audit.items():
        require(privacy, "Privacy and external transmission", f"credential_retention_audit.{key}", value, errors)

    official = capsule["official_v11"]
    for key in ("status", "result_sha256", "required_step_count", "phase_8_ready"):
        require(observed, "Observed results", f"official_v11.{key}", official[key], errors)
    for status, count in official["status_counts"].items():
        require(coverage, "Coverage and failures", f"official_v11.status_counts.{status}", count, errors)
    require(acceptance, "Acceptance results", "admission_status", capsule.get("admission_status"), errors)
    require(acceptance, "Acceptance results", "blocking_classification", capsule.get("blocking_classification"), errors)
    require(acceptance, "Acceptance results", "phase_8_ready", capsule["phase_8_ready"], errors)
    for outcome in capsule.get("authenticated_codex_outcomes", []):
        require(acceptance, "Acceptance results", "authenticated_codex_outcomes.target", outcome.get("target"), errors)
        require(acceptance, "Acceptance results", f"authenticated_codex_outcomes.{outcome.get('target')}.status", outcome.get("status"), errors)
        require(acceptance, "Acceptance results", f"authenticated_codex_outcomes.{outcome.get('target')}.classification", outcome.get("classification"), errors)
    require(
        revisit,
        "Decision revisit trigger status",
        "active_decision_revisit_triggers",
        capsule["active_decision_revisit_triggers"],
        errors,
    )
    require(
        revisit,
        "Decision revisit trigger status",
        "decision_revisit_trigger_assessment",
        capsule["decision_revisit_trigger_assessment"],
        errors,
    )
    return errors


def self_test_capsule() -> dict[str, Any]:
    head = "a" * 40
    tools = {
        name: {
            "argv": [name if name != "python" else "python3", "--version"],
            "status": "available",
            "version": f"{name} 1.2.3",
            "exit_code": 0,
        }
        for name in REQUIRED_TOOLS
    }
    return {
        "kind": "validation_handoff_capsule",
        "validated_candidate_head": head,
        "admission_status": "eligible",
        "blocking_classification": None,
        "execution_environment": {
            "platform": {
                "operating_system": "Linux", "release": "6.12.0", "platform_version": "#1 test",
                "machine": "x86_64", "architecture": "64bit",
            },
            "python_runtime": {"implementation": "CPython", "version": "3.13.0", "executable_basename": "python3"},
            "tools": tools,
        },
        "dependency_snapshot": {
            "candidate_head": head,
            "cargo_lock": {"path": "rebuild/Cargo.lock", "status": "available", "sha256": "b" * 64},
            "workspace_manifest": {"path": "rebuild/Cargo.toml", "status": "available", "sha256": "c" * 64},
            "fixture_manifest": {"path": "rebuild/validation/shared/fixture-manifest.json", "status": "available", "sha256": "d" * 64},
        },
        "gate_configuration": {
            "argv": ["rebuild/scripts/validate", "gate", "--external-network", "available", "--authorize-external-transmission", "v11-test-authorization"],
            "argv_status": "complete",
            "technical_external_network_assertion": "available",
            "authorization_assertion_id": "v11-test-authorization",
            "external_transmission": {
                "required": True,
                "destination": "test Codex service",
                "purpose": "three bounded health turns",
                "scope": ["volicord", "small-python", "polyglot-medium"],
                "source_scope": "bounded prompt and tool result; no source body",
                "authorization_assertion": "v11-test-authorization",
            },
            "same_session_artifact_flow": {
                "final_artifact_produced_by_gate": True,
                "v11_preflight_consumed_same_gate_final_artifact": True,
                "official_v11_consumed_same_gate_final_artifact": True,
            },
        },
        "final_aggregate": {
            "status": "succeeded", "command_count": 1, "failure_count": 0,
            "commands": [{"name": "cargo_test", "argv": ["cargo", "test", "--workspace"], "outcome": "succeeded", "exit_code": 0, "termination": None, "duration_ms": 1.0}],
        },
        "final_summary_sha256": "e" * 64,
        "official_v11": {"status": "passed", "result_sha256": "f" * 64, "required_step_count": 2, "status_counts": {"passed": 2}, "phase_8_ready": True},
        "required_identities": {"candidate_head": head, "fixtures": [{"id": "fixture-one", "validation_id": "V11", "content_sha256": "1" * 64}]},
        "credential_retention_audit": {"status": "passed", "auth_named_file_count": 0, "credential_content_match_count": 0, "scan_error_count": 0},
        "authenticated_codex_outcomes": [{"target": "volicord", "status": "passed", "classification": "passed"}],
        "active_decision_revisit_triggers": [],
        "decision_revisit_trigger_assessment": "reported_by_official_v11",
        "phase_8_ready": True,
    }


def self_test_report(capsule: dict[str, Any]) -> str:
    def flat_lines(value: dict[str, Any], prefix: str = "") -> list[str]:
        lines: list[str] = []
        for key, item in value.items():
            label = f"{prefix}.{key}" if prefix else key
            if isinstance(item, dict):
                lines.extend(flat_lines(item, label))
            elif not isinstance(item, list):
                lines.append(f"{label} = {scalar_text(item)}")
        return lines

    content = {section: "Maintained test content." for section in SECTIONS}
    content["Input repositories and revisions"] = "\n".join((
        f"validated_candidate_head = {capsule['validated_candidate_head']}",
        *flat_lines(capsule["dependency_snapshot"]),
        *(
            line
            for fixture in capsule["required_identities"]["fixtures"]
            for line in (
                f"fixture.id = {fixture['id']}",
                f"fixture.content_sha256 = {fixture['content_sha256']}",
            )
        ),
    ))
    content["Environment and tool versions"] = "\n".join(flat_lines(capsule["execution_environment"]))
    content["Commands and configuration"] = "\n".join((
        f"gate_configuration.argv = {shlex.join(capsule['gate_configuration']['argv'])}",
        *flat_lines(capsule["gate_configuration"]),
        f"final_command.cargo_test = {shlex.join(capsule['final_aggregate']['commands'][0]['argv'])}",
        *(
            f"final_command.cargo_test.{key} = {scalar_text(capsule['final_aggregate']['commands'][0][key])}"
            for key in ("outcome", "exit_code", "termination", "duration_ms")
        ),
        *flat_lines({"final_aggregate": {key: value for key, value in capsule["final_aggregate"].items() if key != "commands"}}),
        f"final_summary_sha256 = {capsule['final_summary_sha256']}",
    ))
    content["Observed results"] = "\n".join(flat_lines({
        "official_v11": {key: value for key, value in capsule["official_v11"].items() if key != "status_counts"},
    }))
    content["Coverage and failures"] = "\n".join(flat_lines({
        "official_v11": {"status_counts": capsule["official_v11"]["status_counts"]},
    }))
    content["Privacy and external transmission"] = "\n".join((
        *flat_lines({"external_transmission": capsule["gate_configuration"]["external_transmission"]}),
        *(f"external_transmission.scope = {target}" for target in capsule["gate_configuration"]["external_transmission"]["scope"]),
        *flat_lines({"credential_retention_audit": capsule["credential_retention_audit"]}),
    ))
    content["Acceptance results"] = "\n".join((
        *flat_lines({
            "admission_status": capsule["admission_status"],
            "blocking_classification": capsule["blocking_classification"],
            "phase_8_ready": capsule["phase_8_ready"],
        }),
        *(
            line
            for outcome in capsule["authenticated_codex_outcomes"]
            for line in (
                f"authenticated_codex_outcomes.target = {outcome['target']}",
                f"authenticated_codex_outcomes.{outcome['target']}.status = {outcome['status']}",
                f"authenticated_codex_outcomes.{outcome['target']}.classification = {outcome['classification']}",
            )
        ),
    ))
    content["Decision revisit trigger status"] = "\n".join((
        f"active_decision_revisit_triggers = {scalar_text(capsule['active_decision_revisit_triggers'])}",
        f"decision_revisit_trigger_assessment = {capsule['decision_revisit_trigger_assessment']}",
    ))
    return "# V11 — Semantic checker self-test\n\n" + "\n\n".join(
        f"## {section}\n\n{content[section]}" for section in SECTIONS
    ) + "\n"


def self_test() -> int:
    capsule = self_test_capsule()
    report = self_test_report(capsule)
    assert check_shape_text(report) == []
    assert check_capsule_semantics(report, capsule) == []

    missing_version = report.replace("cargo 1.2.3", "version omitted from report")
    version_errors = check_capsule_semantics(missing_version, capsule)
    assert any("tools.cargo.version" in error for error in version_errors)

    command_text = shlex.join(capsule["final_aggregate"]["commands"][0]["argv"])
    missing_argv = report.replace(command_text, "command vector omitted")
    argv_errors = check_capsule_semantics(missing_argv, capsule)
    assert any("final_command.cargo_test" in error for error in argv_errors)

    incomplete_capsule = copy.deepcopy(capsule)
    incomplete_capsule["execution_environment"]["tools"]["rustc"]["version"] = None
    assert any("tools.rustc.version" in error for error in capsule_contract_errors(incomplete_capsule))
    incomplete_capsule = copy.deepcopy(capsule)
    incomplete_capsule["final_aggregate"]["commands"][0]["argv"] = []
    assert any("final command argv" in error for error in capsule_contract_errors(incomplete_capsule))

    with tempfile.TemporaryDirectory(prefix="validation-report-checker-self-test-") as directory:
        path = Path(directory) / "generic-report.md"
        path.write_text(report, encoding="utf-8")
        assert check(path) == []
    print("validation report checker self-test passed")
    return 0


def parse_args(arguments: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="rebuild/scripts/check-validation-report",
        description="Check maintained report shape and optional capsule-backed V11 semantics.",
    )
    parser.add_argument("report", nargs="?", type=Path)
    parser.add_argument("--capsule", type=Path)
    parser.add_argument("--self-test", action="store_true")
    return parser.parse_args(arguments)


def main(arguments: Sequence[str]) -> int:
    args = parse_args(arguments)
    if args.self_test:
        if args.report is not None or args.capsule is not None:
            print("--self-test does not accept report or capsule arguments", file=sys.stderr)
            return 2
        try:
            return self_test()
        except (AssertionError, OSError, ValueError, json.JSONDecodeError) as error:
            print(f"validation report checker self-test failed: {error}", file=sys.stderr)
            return 1
    if args.report is None:
        print("a report path is required", file=sys.stderr)
        return 2
    if not args.report.is_file():
        print(f"report does not exist: {args.report}", file=sys.stderr)
        return 2
    errors = check(args.report)
    if args.capsule is not None:
        if not args.capsule.is_file():
            print(f"capsule does not exist: {args.capsule}", file=sys.stderr)
            return 2
        try:
            capsule = json.loads(args.capsule.read_text(encoding="utf-8"))
        except json.JSONDecodeError as error:
            print(f"capsule is not valid JSON: {error}", file=sys.stderr)
            return 2
        if not isinstance(capsule, dict):
            print("capsule root must be an object", file=sys.stderr)
            return 2
        errors.extend(check_capsule_semantics(args.report.read_text(encoding="utf-8"), capsule))
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1
    mode = "capsule-backed semantics" if args.capsule is not None else "shape"
    print(f"validation report {mode} passed: {args.report}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
