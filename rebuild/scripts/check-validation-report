#!/usr/bin/env python3
"""Check maintained validation report shape and optional V11 capsule semantics."""

from __future__ import annotations

import argparse
import copy
import json
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
from typing import Any, Sequence


SECTIONS = (
    "Status",
    "Goal",
    "Accepted decisions being validated",
    "Input repositories and revisions",
    "Environment and tool versions",
    "Candidate approaches",
    "Commands and configuration",
    "Observed results",
    "Coverage and failures",
    "Performance and resource observations",
    "Privacy and external transmission",
    "Acceptance results",
    "Known limits",
    "Recommended implementation choice",
    "Rejected alternatives and reasons",
    "Reusable primitive decision",
    "Decision revisit trigger status",
    "Follow-up work",
    "Artifacts",
)
REQUIRED_TOOLS = ("python", "git", "cargo", "rustc", "codex")
DEPENDENCY_IDENTITIES = ("cargo_lock", "workspace_manifest", "fixture_manifest")
FINAL_COMMAND_LABELS = ("cargo_metadata", "cargo_fmt", "cargo_clippy", "cargo_test")
FINAL_COMMANDS = (
    (
        "cargo", "metadata", "--manifest-path", "rebuild/Cargo.toml",
        "--no-deps", "--format-version", "1",
    ),
    (
        "cargo", "fmt", "--manifest-path", "rebuild/Cargo.toml", "--all", "--", "--check",
    ),
    (
        "cargo", "clippy", "--manifest-path", "rebuild/Cargo.toml",
        "--workspace", "--all-targets", "--all-features",
    ),
    (
        "cargo", "test", "--manifest-path", "rebuild/Cargo.toml",
        "--workspace", "--all-targets", "--all-features",
    ),
)
FLOW_KEYS = (
    "final_artifact_produced_by_gate",
    "v11_preflight_consumed_same_gate_final_artifact",
    "official_v11_consumed_same_gate_final_artifact",
)
SHA256 = re.compile(r"[0-9a-f]{64}")
HEAD = re.compile(r"[0-9a-f]{40}")
REPOSITORY_ROOT = Path(__file__).resolve().parents[2]


def report_sections(text: str) -> dict[str, str]:
    lines = text.splitlines()
    headings = {
        line.removeprefix("## "): index
        for index, line in enumerate(lines)
        if line.startswith("## ")
    }
    result: dict[str, str] = {}
    for section in SECTIONS:
        start = headings.get(section)
        if start is None:
            continue
        end = next(
            (index for index in range(start + 1, len(lines)) if lines[index].startswith("## ")),
            len(lines),
        )
        result[section] = "\n".join(lines[start + 1 : end])
    return result


def check_shape_text(text: str) -> list[str]:
    errors: list[str] = []
    lines = text.splitlines()
    if not lines or not re.fullmatch(r"# V\d{2} — .+", lines[0]):
        errors.append("first line must be '# VNN — <title>'")
    positions: list[int] = []
    for section in SECTIONS:
        heading = f"## {section}"
        matching = [index for index, line in enumerate(lines) if line == heading]
        if len(matching) != 1:
            errors.append(f"expected exactly one heading: {heading}")
            continue
        positions.append(matching[0])
        next_nonblank = next((line for line in lines[matching[0] + 1 :] if line.strip()), "")
        if not next_nonblank or next_nonblank.startswith("## "):
            errors.append(f"section has no content: {heading}")
    if positions != sorted(positions):
        errors.append("required headings are out of order")
    return errors


def check(path: Path) -> list[str]:
    return check_shape_text(path.read_text(encoding="utf-8"))


def copied_capsule(path: Path) -> dict[str, Any]:
    resolved = path.resolve(strict=True)
    try:
        resolved.relative_to(REPOSITORY_ROOT)
    except ValueError:
        pass
    else:
        ignored = subprocess.run(
            ["git", "check-ignore", "--quiet", "--no-index", "--", str(resolved)],
            cwd=REPOSITORY_ROOT,
            check=False,
        )
        if ignored.returncode not in {0, 1}:
            raise ValueError("could not establish the capsule's ignored-path state")
        if ignored.returncode == 0:
            raise ValueError(
                "capsule-backed documentation validation requires an explicit copy "
                "outside ignored repository runtime evidence"
            )
    value = json.loads(resolved.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError("capsule root must be an object")
    return value


def mapping(value: Any, label: str, errors: list[str]) -> dict[str, Any]:
    if not isinstance(value, dict):
        errors.append(f"capsule field must be an object: {label}")
        return {}
    return value


def sequence(value: Any, label: str, errors: list[str]) -> list[Any]:
    if not isinstance(value, list):
        errors.append(f"capsule field must be an array: {label}")
        return []
    return value


def nonempty_string(value: Any, label: str, errors: list[str]) -> str:
    if not isinstance(value, str) or not value:
        errors.append(f"capsule field must be a nonempty string: {label}")
        return ""
    return value


def digest(value: Any, label: str, errors: list[str], pattern: re.Pattern[str] = SHA256) -> str:
    text = nonempty_string(value, label, errors)
    if text and not pattern.fullmatch(text):
        errors.append(f"capsule field has invalid digest/identity syntax: {label}")
    return text


def optional_digest(
    value: Any,
    label: str,
    errors: list[str],
    pattern: re.Pattern[str] = SHA256,
) -> str | None:
    if value is None:
        return None
    return digest(value, label, errors, pattern)


def capsule_contract_errors(capsule: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    if capsule.get("kind") != "validation_handoff_capsule":
        errors.append("capsule kind must be validation_handoff_capsule")
    candidate_head = optional_digest(
        capsule.get("validated_candidate_head"), "validated_candidate_head", errors, HEAD
    )
    admission_status = capsule.get("admission_status")
    if admission_status not in {"eligible", "blocked"}:
        errors.append("capsule admission_status must be eligible or blocked")
    blocking = capsule.get("blocking_classification")
    if blocking is not None and (not isinstance(blocking, str) or not blocking):
        errors.append("capsule blocking_classification must be null or a nonempty string")

    admission_checks = sequence(capsule.get("admission_checks"), "admission_checks", errors)
    if not admission_checks:
        errors.append("capsule admission checks are empty")
    admission_check_statuses: list[str] = []
    admission_check_names: list[str] = []
    for index, value in enumerate(admission_checks):
        admission_check = mapping(value, f"admission_checks[{index}]", errors)
        name = nonempty_string(
            admission_check.get("name"), f"admission_checks[{index}].name", errors
        )
        status = nonempty_string(
            admission_check.get("status"), f"admission_checks[{index}].status", errors
        )
        if status not in {"passed", "failed", "environment_blocked", "authorization_blocked"}:
            errors.append(f"capsule admission check status is invalid: index {index}")
        admission_check_names.append(name)
        admission_check_statuses.append(status)
    if len(set(admission_check_names)) != len(admission_check_names):
        errors.append("capsule admission check names must be unique")
    if admission_status == "eligible" and any(
        status != "passed" for status in admission_check_statuses
    ):
        errors.append("capsule eligible admission requires every admission check to pass")
    if admission_status == "blocked" and all(
        status == "passed" for status in admission_check_statuses
    ):
        errors.append("capsule blocked admission requires a non-passing admission check")
    if admission_status == "blocked":
        expected_status = {
            "authorization_blocked": "authorization_blocked",
            "environment_blocked": "environment_blocked",
            "validation_failed": "failed",
        }.get(blocking)
        if expected_status is None or expected_status not in admission_check_statuses:
            errors.append("capsule admission blocker is not supported by admission checks")
    candidate_check_status = next(
        (
            value.get("status")
            for value in admission_checks
            if isinstance(value, dict)
            and value.get("name") == "candidate_identity_and_clean_worktree"
        ),
        None,
    )
    if (admission_status == "eligible" or candidate_check_status == "passed") and candidate_head is None:
        errors.append("capsule admitted candidate identity is missing")

    environment = mapping(capsule.get("execution_environment"), "execution_environment", errors)
    platform_value = mapping(environment.get("platform"), "execution_environment.platform", errors)
    for key in ("operating_system", "release", "platform_version", "machine", "architecture"):
        nonempty_string(platform_value.get(key), f"execution_environment.platform.{key}", errors)
    runtime = mapping(environment.get("python_runtime"), "execution_environment.python_runtime", errors)
    for key in ("implementation", "version", "executable_basename"):
        nonempty_string(runtime.get(key), f"execution_environment.python_runtime.{key}", errors)
    tools = mapping(environment.get("tools"), "execution_environment.tools", errors)
    for name in REQUIRED_TOOLS:
        tool = mapping(tools.get(name), f"execution_environment.tools.{name}", errors)
        argv = sequence(tool.get("argv"), f"execution_environment.tools.{name}.argv", errors)
        if not argv or not all(isinstance(value, str) and value for value in argv):
            errors.append(f"capsule tool probe argv is incomplete: {name}")
        status = tool.get("status")
        if status not in {"available", "unavailable", "error"}:
            errors.append(f"capsule tool probe status is invalid: {name}")
        if status == "available":
            nonempty_string(tool.get("version"), f"execution_environment.tools.{name}.version", errors)
        elif tool.get("version") is not None or not tool.get("error"):
            errors.append(f"capsule tool probe must preserve explicit unavailable/error state: {name}")

    dependencies = mapping(capsule.get("dependency_snapshot"), "dependency_snapshot", errors)
    dependency_head = optional_digest(
        dependencies.get("candidate_head"), "dependency_snapshot.candidate_head", errors, HEAD
    )
    if dependency_head != candidate_head:
        errors.append("capsule dependency candidate HEAD does not match validated_candidate_head")
    for name in DEPENDENCY_IDENTITIES:
        identity = mapping(dependencies.get(name), f"dependency_snapshot.{name}", errors)
        nonempty_string(identity.get("path"), f"dependency_snapshot.{name}.path", errors)
        identity_status = identity.get("status")
        if identity_status not in {"available", "unavailable", "error"}:
            errors.append(f"capsule dependency identity status is invalid: {name}")
        if identity_status == "available":
            digest(identity.get("sha256"), f"dependency_snapshot.{name}.sha256", errors)
        elif identity.get("sha256") is not None:
            errors.append(f"capsule unavailable dependency identity has a digest: {name}")
        if admission_status == "eligible" and identity_status != "available":
            errors.append(f"capsule eligible admission requires dependency identity: {name}")

    final = mapping(capsule.get("final_aggregate"), "final_aggregate", errors)
    final_status = nonempty_string(final.get("status"), "final_aggregate.status", errors)
    final_started = final_status != "not_run"
    command_count = final.get("command_count")
    failure_count = final.get("failure_count")
    if not isinstance(command_count, int) or command_count < 0:
        errors.append("capsule final_aggregate.command_count must be a nonnegative integer")
    if not isinstance(failure_count, int) or failure_count < 0:
        errors.append("capsule final_aggregate.failure_count must be an integer")
    commands = sequence(final.get("commands"), "final_aggregate.commands", errors)
    if len(commands) != command_count:
        errors.append("capsule final command count does not match commands")
    command_failures = 0
    command_names: list[str] = []
    command_vectors: list[tuple[str, ...]] = []
    for index, value in enumerate(commands):
        command = mapping(value, f"final_aggregate.commands[{index}]", errors)
        command_names.append(nonempty_string(
            command.get("name"), f"final_aggregate.commands[{index}].name", errors
        ))
        argv = sequence(command.get("argv"), f"final_aggregate.commands[{index}].argv", errors)
        if not argv or not all(isinstance(part, str) and part for part in argv):
            errors.append(f"capsule final command argv is incomplete: index {index}")
        command_vectors.append(tuple(part for part in argv if isinstance(part, str)))
        outcome = nonempty_string(
            command.get("outcome"), f"final_aggregate.commands[{index}].outcome", errors
        )
        if outcome not in {"succeeded", "failed", "terminated", "spawn_failed"}:
            errors.append(f"capsule final command outcome is invalid: index {index}")
        if outcome != "succeeded":
            command_failures += 1
        exit_code = command.get("exit_code")
        termination = command.get("termination")
        spawn_error = command.get("spawn_error")
        if not isinstance(spawn_error, bool):
            errors.append(f"capsule final command spawn_error must be a boolean: index {index}")
        if outcome == "succeeded" and (exit_code != 0 or termination is not None or spawn_error):
            errors.append(f"capsule successful final command has inconsistent process state: index {index}")
        if outcome == "failed" and (
            not isinstance(exit_code, int) or exit_code == 0 or termination is not None or spawn_error
        ):
            errors.append(f"capsule failed final command has inconsistent process state: index {index}")
        if outcome == "terminated" and (
            exit_code is not None or not isinstance(termination, dict) or spawn_error
        ):
            errors.append(f"capsule terminated final command has inconsistent process state: index {index}")
        if outcome == "spawn_failed" and (
            exit_code is not None or termination is not None or spawn_error is not True
        ):
            errors.append(f"capsule spawn-failed final command has inconsistent process state: index {index}")
        if not isinstance(command.get("duration_ms"), (int, float)) or command.get("duration_ms", -1) < 0:
            errors.append(f"capsule final command duration_ms must be numeric: index {index}")
    if final_started:
        if admission_status != "eligible":
            errors.append("capsule final commands cannot run after blocked admission")
        if final_status not in {"succeeded", "failed"}:
            errors.append("capsule started final aggregate status is invalid")
        if tuple(command_names) != FINAL_COMMAND_LABELS or command_count != len(FINAL_COMMAND_LABELS):
            errors.append("capsule started final aggregate must contain the exact final command set")
        if tuple(command_vectors) != FINAL_COMMANDS:
            errors.append("capsule started final aggregate argv does not match the exact final contract")
        if failure_count != command_failures:
            errors.append("capsule final aggregate failure count does not match command outcomes")
        if (final_status == "succeeded") != (failure_count == 0):
            errors.append("capsule final aggregate status does not match failure count")
        digest(capsule.get("final_summary_sha256"), "final_summary_sha256", errors)
    elif command_count != 0 or failure_count != 0 or commands or capsule.get("final_summary_sha256") is not None:
        errors.append("capsule final-not-run state contains final execution evidence")

    configuration = mapping(capsule.get("gate_configuration"), "gate_configuration", errors)
    gate_argv = sequence(configuration.get("argv"), "gate_configuration.argv", errors)
    if not gate_argv or not all(isinstance(value, str) and value for value in gate_argv):
        errors.append("capsule gate_configuration.argv is incomplete")
    argv_status = configuration.get("argv_status")
    if argv_status not in {"complete", "unrecognized_authorization_assertion_not_retained"}:
        errors.append("capsule gate_configuration.argv_status is invalid")
    if admission_status == "eligible" and argv_status != "complete":
        errors.append("capsule eligible admission requires complete gate argv")
    nonempty_string(
        configuration.get("technical_external_network_assertion"),
        "gate_configuration.technical_external_network_assertion",
        errors,
    )
    authorization_assertion_id = configuration.get("authorization_assertion_id")
    if authorization_assertion_id is not None:
        nonempty_string(
            authorization_assertion_id,
            "gate_configuration.authorization_assertion_id",
            errors,
        )
    if admission_status == "eligible" and authorization_assertion_id is None:
        errors.append("capsule eligible admission requires an authorization assertion ID")
    transmission = mapping(configuration.get("external_transmission"), "gate_configuration.external_transmission", errors)
    for key in ("destination", "purpose", "source_scope", "authorization_assertion"):
        nonempty_string(transmission.get(key), f"gate_configuration.external_transmission.{key}", errors)
    scopes = sequence(transmission.get("scope"), "gate_configuration.external_transmission.scope", errors)
    if not scopes or not all(isinstance(value, str) and value for value in scopes):
        errors.append("capsule external transmission target scope is incomplete")
    flow = mapping(configuration.get("same_session_artifact_flow"), "gate_configuration.same_session_artifact_flow", errors)
    for key in FLOW_KEYS:
        if not isinstance(flow.get(key), bool):
            errors.append(f"capsule artifact-flow fact must be a boolean: {key}")

    official = mapping(capsule.get("official_v11"), "official_v11", errors)
    official_status = nonempty_string(official.get("status"), "official_v11.status", errors)
    official_started = official_status != "not_run"
    required_step_count = official.get("required_step_count")
    if not isinstance(required_step_count, int) or required_step_count < 0:
        errors.append("capsule official_v11.required_step_count must be a nonnegative integer")
    counts = mapping(official.get("status_counts"), "official_v11.status_counts", errors)
    if not all(
        isinstance(key, str) and key and isinstance(value, int) and value >= 0
        for key, value in counts.items()
    ):
        errors.append("capsule official_v11.status_counts is incomplete")
    official_ready = official.get("phase_8_ready")
    if not isinstance(official_ready, bool):
        errors.append("capsule official_v11.phase_8_ready must be a boolean")
    if official_started:
        if official_status not in {"passed", "failed"}:
            errors.append("capsule started official V11 status is invalid")
        digest(official.get("result_sha256"), "official_v11.result_sha256", errors)
        if not counts or required_step_count <= 0 or required_step_count != sum(counts.values()):
            errors.append("capsule official V11 step count does not match status counts")
        if official_status != "passed" and official_ready is not False:
            errors.append("capsule failed official V11 cannot mark its phase ready")
        if official_status == "passed" and any(
            status != "passed" and count != 0 for status, count in counts.items()
        ):
            errors.append("capsule passed official V11 contains non-passing step counts")
    elif (
        official.get("result_sha256") is not None
        or required_step_count != 0
        or counts
        or official_ready is not False
    ):
        errors.append("capsule official-V11-not-run state contains official V11 evidence")

    identities = mapping(capsule.get("required_identities"), "required_identities", errors)
    identity_head = optional_digest(
        identities.get("candidate_head"), "required_identities.candidate_head", errors, HEAD
    )
    if identity_head != candidate_head:
        errors.append("capsule required identity HEAD does not match validated_candidate_head")
    fixtures = sequence(identities.get("fixtures"), "required_identities.fixtures", errors)
    if admission_status == "eligible" and not fixtures:
        errors.append("capsule required fixture identities are empty")
    for index, value in enumerate(fixtures):
        fixture = mapping(value, f"required_identities.fixtures[{index}]", errors)
        nonempty_string(fixture.get("id"), f"required_identities.fixtures[{index}].id", errors)
        nonempty_string(
            fixture.get("validation_id"),
            f"required_identities.fixtures[{index}].validation_id",
            errors,
        )
        digest(
            fixture.get("content_sha256"),
            f"required_identities.fixtures[{index}].content_sha256",
            errors,
        )

    audit = mapping(capsule.get("credential_retention_audit"), "credential_retention_audit", errors)
    audit_status = nonempty_string(audit.get("status"), "credential_retention_audit.status", errors)
    for key in ("auth_named_file_count", "credential_content_match_count", "scan_error_count"):
        if not isinstance(audit.get(key), int) or audit.get(key, -1) < 0:
            errors.append(f"capsule credential audit count must be an integer: {key}")
    evidence_archive = mapping(capsule.get("evidence_archive"), "evidence_archive", errors)
    archive_status = evidence_archive.get("status")
    if archive_status not in {
        "not_run", "pending", "creation_failed", "verification_failed", "verified"
    }:
        errors.append("capsule evidence_archive.status is invalid")
    archive_prerequisites = evidence_archive.get("prerequisites_passed")
    if not isinstance(archive_prerequisites, bool):
        errors.append("capsule evidence_archive.prerequisites_passed must be a boolean")
    archive_candidate = optional_digest(
        evidence_archive.get("candidate_head"), "evidence_archive.candidate_head", errors, HEAD
    )
    if archive_candidate != candidate_head:
        errors.append("capsule evidence archive candidate does not match validated_candidate_head")
    archive_verified = archive_status == "verified"
    if archive_verified:
        filename = nonempty_string(
            evidence_archive.get("filename"), "evidence_archive.filename", errors
        )
        if filename is not None and ("/" in filename or "\\" in filename):
            errors.append("capsule evidence archive filename must be portable")
        digest(evidence_archive.get("sha256"), "evidence_archive.sha256", errors)
        for key in ("size_bytes", "member_count"):
            if not isinstance(evidence_archive.get(key), int) or evidence_archive.get(key, 0) <= 0:
                errors.append(f"capsule evidence_archive.{key} must be a positive integer")
        if evidence_archive.get("verification_status") != "passed":
            errors.append("capsule verified evidence archive requires independent verification")
    elif archive_status == "not_run":
        if any(
            evidence_archive.get(key) is not None
            for key in ("filename", "sha256", "size_bytes", "member_count")
        ) or evidence_archive.get("verification_status") != "not_run":
            errors.append("capsule evidence archive not-run state contains archive evidence")
    elif archive_status == "creation_failed":
        if evidence_archive.get("verification_status") != "not_run":
            errors.append("capsule archive creation failure contains verification evidence")
    elif archive_status == "verification_failed":
        if evidence_archive.get("verification_status") != "failed":
            errors.append("capsule archive verification failure lacks failed verification state")
    phase_8_ready = capsule.get("phase_8_ready")
    if not isinstance(phase_8_ready, bool):
        errors.append("capsule phase_8_ready must be a boolean")
    trigger_value = capsule.get("active_decision_revisit_triggers")
    triggers_available = isinstance(trigger_value, list)
    triggers = trigger_value if triggers_available else []
    trigger_ids_valid = triggers_available and all(
        isinstance(value, str) and re.fullmatch(r"Q[0-9]+(?:-[A-Z])?", value)
        for value in triggers
    )
    if triggers_available and not trigger_ids_valid:
        errors.append("capsule active Decision revisit triggers must be bounded Decision IDs")
    if trigger_ids_valid and len(triggers) != len(set(triggers)):
        errors.append("capsule active Decision revisit triggers must be unique")
    assessment = capsule.get("decision_revisit_trigger_assessment")
    if not isinstance(assessment, str) or not assessment:
        errors.append("capsule decision_revisit_trigger_assessment must be a nonempty string")
    source_value = capsule.get("decision_revisit_trigger_source")
    source_valid = False
    source_ids: list[Any] = []
    if isinstance(source_value, dict):
        source_ids_value = source_value.get("assessed_decision_ids")
        if isinstance(source_ids_value, list):
            source_ids = source_ids_value
        source_ids_valid = bool(source_ids) and all(
            isinstance(value, str) and re.fullmatch(r"Q[0-9]+(?:-[A-Z])?", value)
            for value in source_ids
        )
        source_valid = (
            source_value.get("kind") == "accepted_decision_register"
            and source_value.get("path") == "rebuild/docs/design/open-decisions.md"
            and isinstance(source_value.get("content_sha256"), str)
            and SHA256.fullmatch(source_value["content_sha256"]) is not None
            and source_ids_valid
            and len(source_ids) == len(set(source_ids))
            and source_value.get("assessed_decision_count") == len(source_ids)
        )
    outcomes = sequence(capsule.get("authenticated_codex_outcomes"), "authenticated_codex_outcomes", errors)
    outcome_targets: list[str] = []
    for index, value in enumerate(outcomes):
        outcome = mapping(value, f"authenticated_codex_outcomes[{index}]", errors)
        for key in ("target", "status", "classification"):
            nonempty_string(
                outcome.get(key),
                f"authenticated_codex_outcomes[{index}].{key}",
                errors,
            )
        target = outcome.get("target")
        if isinstance(target, str):
            outcome_targets.append(target)
            if target not in scopes:
                errors.append(f"capsule authenticated Codex outcome target is out of scope: {target}")
    if len(outcome_targets) != len(set(outcome_targets)):
        errors.append("capsule authenticated Codex outcome targets must be unique")

    pre_final = capsule.get("pre_final_candidate_check")
    if pre_final is not None:
        pre_final = mapping(pre_final, "pre_final_candidate_check", errors)
        nonempty_string(pre_final.get("name"), "pre_final_candidate_check.name", errors)
        nonempty_string(pre_final.get("status"), "pre_final_candidate_check.status", errors)

    final_passed = final_started and final_status == "succeeded" and failure_count == 0
    expected_flow = (
        (False, False, False)
        if not final_started
        else (True, False, False)
        if not final_passed
        else (True, True, True)
        if official_started
        else (True, True, False)
    )
    actual_flow = tuple(flow.get(key) for key in FLOW_KEYS)
    if actual_flow != expected_flow:
        errors.append("capsule same-session artifact flow is inconsistent with observed stages")

    if final_started and (not isinstance(pre_final, dict) or pre_final.get("status") != "passed"):
        errors.append("capsule final start requires a passed pre-final candidate check")
    if not final_started and admission_status == "eligible":
        if not isinstance(pre_final, dict) or pre_final.get("status") == "passed":
            errors.append("capsule eligible admission without final requires a failed pre-final check")
        if blocking not in {"candidate_changed", "candidate_worktree_dirty", "candidate_state_unavailable"}:
            errors.append("capsule pre-final blocker classification is invalid")
        details = mapping(
            pre_final.get("details") if isinstance(pre_final, dict) else None,
            "pre_final_candidate_check.details",
            errors,
        )
        if blocking == "candidate_changed" and details.get("head_unchanged") is not False:
            errors.append("capsule candidate-changed blocker lacks supporting pre-final evidence")
        if blocking == "candidate_worktree_dirty" and (
            not isinstance(details.get("dirty_entry_count"), int)
            or details.get("dirty_entry_count", 0) <= 0
        ):
            errors.append("capsule dirty-worktree blocker lacks supporting pre-final evidence")

    if not final_started:
        if official_started or outcomes or audit_status != "not_run":
            errors.append("capsule final-not-run state contains later-stage evidence")
    elif not final_passed:
        if blocking != "final_failed" or official_started or outcomes or audit_status != "not_run":
            errors.append("capsule final failure contains inconsistent V11 evidence")
    elif not official_started:
        if blocking != "v11_preflight_failed" or outcomes or audit_status != "not_run":
            errors.append("capsule V11 preflight failure contains inconsistent official V11 evidence")
    else:
        if audit_status == "not_run":
            errors.append("capsule official V11 start requires credential-audit evidence")
        if blocking not in {
            None,
            "v11_failed",
            "credential_retention_audit_failed",
            "evidence_archive_pending",
            "evidence_archive_creation_failed",
            "evidence_archive_verification_failed",
        }:
            errors.append("capsule official V11 blocker classification is invalid")
        if official_status == "passed":
            if set(outcome_targets) != set(scopes) or any(
                value.get("status") != "passed" or value.get("classification") != "passed"
                for value in outcomes if isinstance(value, dict)
            ):
                errors.append("capsule passed official V11 requires every authenticated target to pass")

    if not official_started:
        if assessment != "not_run" or trigger_value is not None or source_value is not None:
            errors.append("capsule official-V11-not-run state contains revisit assessment evidence")
    elif assessment == "reported_by_official_v11":
        if not triggers_available or not source_valid:
            errors.append("capsule official revisit assessment lacks bounded source-backed evidence")
        elif any(value not in source_ids for value in triggers):
            errors.append("capsule active revisit trigger is outside the assessed Decision source")
        if official_status == "passed" and triggers != []:
            errors.append("capsule passed official V11 cannot contain an active revisit trigger")
    elif assessment == "official_v11_assessment_failed":
        if trigger_value is not None:
            errors.append("capsule failed revisit assessment must not project an empty trigger list")
        if official_status == "passed":
            errors.append("capsule passed official V11 cannot have an unassessable revisit result")
    else:
        errors.append("capsule started official V11 lacks an official revisit assessment state")

    fully_passed = (
        admission_status == "eligible"
        and blocking is None
        and final_passed
        and official_status == "passed"
        and official_ready is True
        and audit_status == "passed"
        and archive_verified
        and archive_prerequisites is True
        and assessment == "reported_by_official_v11"
        and triggers_available
        and triggers == []
        and source_valid
        and actual_flow == (True, True, True)
        and set(outcome_targets) == set(scopes)
        and all(
            isinstance(value, dict)
            and value.get("status") == "passed"
            and value.get("classification") == "passed"
            for value in outcomes
        )
    )
    if phase_8_ready is True and not fully_passed:
        errors.append("capsule phase_8_ready requires a fully passed unified V11 gate")
    if fully_passed and phase_8_ready is not True:
        errors.append("capsule fully passed unified V11 gate must mark phase_8_ready true")
    if not fully_passed and phase_8_ready is not False:
        errors.append("capsule non-passing lifecycle must mark phase_8_ready false")
    if official_status == "passed" and assessment != "reported_by_official_v11":
        errors.append("capsule passed V11 requires the official revisit-trigger assessment")
    technical_prerequisites_passed = (
        admission_status == "eligible"
        and final_passed
        and official_status == "passed"
        and official_ready is True
        and audit_status == "passed"
        and assessment == "reported_by_official_v11"
        and triggers_available
        and triggers == []
        and source_valid
        and actual_flow == (True, True, True)
    )
    if archive_prerequisites is not technical_prerequisites_passed:
        errors.append("capsule evidence archive prerequisite state is inconsistent")
    if technical_prerequisites_passed and not archive_verified:
        expected_blocker = {
            "pending": "evidence_archive_pending",
            "creation_failed": "evidence_archive_creation_failed",
            "verification_failed": "evidence_archive_verification_failed",
        }.get(archive_status)
        if expected_blocker is None or blocking != expected_blocker:
            errors.append("capsule post-V11 archive stage lacks its truthful blocker")
    return errors


def scalar_text(value: Any) -> str:
    if isinstance(value, str):
        return value
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def require(section: str, section_name: str, label: str, value: Any, errors: list[str]) -> None:
    rendered = scalar_text(value)
    if label not in section or rendered not in section:
        errors.append(
            f"capsule-backed report section '{section_name}' must record {label} = {rendered}"
        )


def check_capsule_semantics(text: str, capsule: dict[str, Any]) -> list[str]:
    errors = capsule_contract_errors(capsule)
    if errors:
        return errors
    sections = report_sections(text)
    inputs = sections.get("Input repositories and revisions", "")
    environment_section = sections.get("Environment and tool versions", "")
    commands_section = sections.get("Commands and configuration", "")
    observed = sections.get("Observed results", "")
    coverage = sections.get("Coverage and failures", "")
    privacy = sections.get("Privacy and external transmission", "")
    acceptance = sections.get("Acceptance results", "")
    revisit = sections.get("Decision revisit trigger status", "")

    head = capsule["validated_candidate_head"]
    if head is not None:
        require(inputs, "Input repositories and revisions", "validated_candidate_head", head, errors)
    dependencies = capsule["dependency_snapshot"]
    for name in DEPENDENCY_IDENTITIES:
        identity = dependencies[name]
        require(inputs, "Input repositories and revisions", name, identity["path"], errors)
        require(inputs, "Input repositories and revisions", f"{name}.status", identity["status"], errors)
        if identity["sha256"] is not None:
            require(inputs, "Input repositories and revisions", f"{name}.sha256", identity["sha256"], errors)
    fixtures = capsule.get("required_identities", {}).get("fixtures", [])
    for fixture in fixtures:
        require(inputs, "Input repositories and revisions", "fixture.id", fixture.get("id"), errors)
        require(inputs, "Input repositories and revisions", "fixture.content_sha256", fixture.get("content_sha256"), errors)

    environment = capsule["execution_environment"]
    for key, value in environment["platform"].items():
        require(environment_section, "Environment and tool versions", f"platform.{key}", value, errors)
    for key, value in environment["python_runtime"].items():
        require(environment_section, "Environment and tool versions", f"python_runtime.{key}", value, errors)
    for name in REQUIRED_TOOLS:
        tool = environment["tools"][name]
        require(environment_section, "Environment and tool versions", f"tools.{name}.status", tool["status"], errors)
        require(
            environment_section,
            "Environment and tool versions",
            f"tools.{name}.version" if tool["status"] == "available" else f"tools.{name}.error",
            tool["version"] if tool["status"] == "available" else tool["error"],
            errors,
        )
    configuration = capsule["gate_configuration"]
    require(commands_section, "Commands and configuration", "gate_configuration.argv", shlex.join(configuration["argv"]), errors)
    require(
        commands_section,
        "Commands and configuration",
        "technical_external_network_assertion",
        configuration["technical_external_network_assertion"],
        errors,
    )
    if configuration["authorization_assertion_id"] is not None:
        require(
            commands_section,
            "Commands and configuration",
            "authorization_assertion_id",
            configuration["authorization_assertion_id"],
            errors,
        )
    for key, value in configuration["same_session_artifact_flow"].items():
        require(commands_section, "Commands and configuration", key, value, errors)
    final = capsule["final_aggregate"]
    if final["status"] != "not_run":
        for key in ("status", "command_count", "failure_count"):
            require(commands_section, "Commands and configuration", f"final_aggregate.{key}", final[key], errors)
        for command in final["commands"]:
            label = f"final_command.{command['name']}"
            require(commands_section, "Commands and configuration", label, shlex.join(command["argv"]), errors)
            for key in ("outcome", "exit_code", "termination", "spawn_error", "duration_ms"):
                require(commands_section, "Commands and configuration", f"{label}.{key}", command[key], errors)
        require(commands_section, "Commands and configuration", "final_summary_sha256", capsule["final_summary_sha256"], errors)

    transmission = configuration["external_transmission"]
    for key in ("destination", "purpose", "source_scope"):
        require(privacy, "Privacy and external transmission", f"external_transmission.{key}", transmission[key], errors)
    for target in transmission["scope"]:
        require(privacy, "Privacy and external transmission", "external_transmission.scope", target, errors)
    require(
        privacy,
        "Privacy and external transmission",
        "external_transmission.authorization_assertion",
        transmission["authorization_assertion"],
        errors,
    )
    audit = capsule["credential_retention_audit"]
    if audit["status"] != "not_run":
        for key, value in audit.items():
            require(privacy, "Privacy and external transmission", f"credential_retention_audit.{key}", value, errors)

    official = capsule["official_v11"]
    if official["status"] != "not_run":
        for key in ("status", "result_sha256", "required_step_count", "phase_8_ready"):
            require(observed, "Observed results", f"official_v11.{key}", official[key], errors)
        for status, count in official["status_counts"].items():
            require(coverage, "Coverage and failures", f"official_v11.status_counts.{status}", count, errors)
    require(acceptance, "Acceptance results", "admission_status", capsule.get("admission_status"), errors)
    require(acceptance, "Acceptance results", "blocking_classification", capsule.get("blocking_classification"), errors)
    require(acceptance, "Acceptance results", "phase_8_ready", capsule["phase_8_ready"], errors)
    for key, value in capsule["evidence_archive"].items():
        require(
            acceptance,
            "Acceptance results",
            f"evidence_archive.{key}",
            value,
            errors,
        )
    for admission_check in capsule["admission_checks"]:
        require(
            acceptance,
            "Acceptance results",
            f"admission_check.{admission_check['name']}.status",
            admission_check["status"],
            errors,
        )
    pre_final = capsule.get("pre_final_candidate_check")
    if pre_final is not None:
        require(
            acceptance,
            "Acceptance results",
            "pre_final_candidate_check.status",
            pre_final["status"],
            errors,
        )
    for outcome in capsule.get("authenticated_codex_outcomes", []):
        require(acceptance, "Acceptance results", "authenticated_codex_outcomes.target", outcome.get("target"), errors)
        require(acceptance, "Acceptance results", f"authenticated_codex_outcomes.{outcome.get('target')}.status", outcome.get("status"), errors)
        require(acceptance, "Acceptance results", f"authenticated_codex_outcomes.{outcome.get('target')}.classification", outcome.get("classification"), errors)
    if official["status"] != "not_run":
        require(
            revisit,
            "Decision revisit trigger status",
            "active_decision_revisit_triggers",
            capsule["active_decision_revisit_triggers"],
            errors,
        )
        require(
            revisit,
            "Decision revisit trigger status",
            "decision_revisit_trigger_assessment",
            capsule["decision_revisit_trigger_assessment"],
            errors,
        )
        source = capsule.get("decision_revisit_trigger_source")
        if isinstance(source, dict):
            for key, value in source.items():
                require(
                    revisit,
                    "Decision revisit trigger status",
                    f"decision_revisit_trigger_source.{key}",
                    value,
                    errors,
                )
    return errors


def self_test_capsule() -> dict[str, Any]:
    head = "a" * 40
    tools = {
        name: {
            "argv": [name if name != "python" else "python3", "--version"],
            "status": "available",
            "version": f"{name} 1.2.3",
            "exit_code": 0,
        }
        for name in REQUIRED_TOOLS
    }
    final_commands = [
        {
            "name": name,
            "argv": list(argv),
            "outcome": "succeeded",
            "exit_code": 0,
            "termination": None,
            "spawn_error": False,
            "duration_ms": float(index),
        }
        for index, (name, argv) in enumerate(
            zip(FINAL_COMMAND_LABELS, FINAL_COMMANDS), start=1
        )
    ]
    return {
        "kind": "validation_handoff_capsule",
        "validated_candidate_head": head,
        "admission_status": "eligible",
        "blocking_classification": None,
        "admission_checks": [
            {"name": "candidate_identity_and_clean_worktree", "status": "passed"},
            {"name": "operator_external_transmission_authorization", "status": "passed"},
        ],
        "pre_final_candidate_check": {
            "name": "pre_final_candidate_identity_and_clean_worktree",
            "status": "passed",
        },
        "execution_environment": {
            "platform": {
                "operating_system": "Linux", "release": "6.12.0", "platform_version": "#1 test",
                "machine": "x86_64", "architecture": "64bit",
            },
            "python_runtime": {"implementation": "CPython", "version": "3.13.0", "executable_basename": "python3"},
            "tools": tools,
        },
        "dependency_snapshot": {
            "candidate_head": head,
            "cargo_lock": {"path": "rebuild/Cargo.lock", "status": "available", "sha256": "b" * 64},
            "workspace_manifest": {"path": "rebuild/Cargo.toml", "status": "available", "sha256": "c" * 64},
            "fixture_manifest": {"path": "rebuild/validation/shared/fixture-manifest.json", "status": "available", "sha256": "d" * 64},
        },
        "gate_configuration": {
            "argv": ["rebuild/scripts/validate", "gate", "--external-network", "available", "--authorize-external-transmission", "v11-test-authorization"],
            "argv_status": "complete",
            "technical_external_network_assertion": "available",
            "authorization_assertion_id": "v11-test-authorization",
            "external_transmission": {
                "required": True,
                "destination": "test Codex service",
                "purpose": "three bounded health turns",
                "scope": ["volicord", "small-python", "polyglot-medium"],
                "source_scope": "bounded prompt and tool result; no source body",
                "authorization_assertion": "v11-test-authorization",
            },
            "same_session_artifact_flow": {
                "final_artifact_produced_by_gate": True,
                "v11_preflight_consumed_same_gate_final_artifact": True,
                "official_v11_consumed_same_gate_final_artifact": True,
            },
        },
        "final_aggregate": {
            "status": "succeeded", "command_count": len(final_commands), "failure_count": 0,
            "commands": final_commands,
        },
        "final_summary_sha256": "e" * 64,
        "official_v11": {"status": "passed", "result_sha256": "f" * 64, "required_step_count": 3, "status_counts": {"passed": 3}, "phase_8_ready": True},
        "required_identities": {"candidate_head": head, "fixtures": [{"id": "fixture-one", "validation_id": "V11", "content_sha256": "1" * 64}]},
        "credential_retention_audit": {"status": "passed", "auth_named_file_count": 0, "credential_content_match_count": 0, "scan_error_count": 0},
        "authenticated_codex_outcomes": [
            {"target": target, "status": "passed", "classification": "passed"}
            for target in ("volicord", "small-python", "polyglot-medium")
        ],
        "active_decision_revisit_triggers": [],
        "decision_revisit_trigger_assessment": "reported_by_official_v11",
        "decision_revisit_trigger_source": {
            "kind": "accepted_decision_register",
            "path": "rebuild/docs/design/open-decisions.md",
            "content_sha256": "2" * 64,
            "assessed_decision_ids": ["Q1", "Q2", "Q3"],
            "assessed_decision_count": 3,
        },
        "evidence_archive": {
            "status": "verified",
            "prerequisites_passed": True,
            "candidate_head": head,
            "filename": "validation-evidence-aaaaaaaaaaaa.tar.gz",
            "sha256": "3" * 64,
            "size_bytes": 4096,
            "member_count": 8,
            "verification_status": "passed",
        },
        "phase_8_ready": True,
    }


def self_test_report(capsule: dict[str, Any]) -> str:
    def flat_lines(value: dict[str, Any], prefix: str = "") -> list[str]:
        lines: list[str] = []
        for key, item in value.items():
            label = f"{prefix}.{key}" if prefix else key
            if isinstance(item, dict):
                lines.extend(flat_lines(item, label))
            elif not isinstance(item, list):
                lines.append(f"{label} = {scalar_text(item)}")
        return lines

    content = {section: "Maintained test content." for section in SECTIONS}
    content["Input repositories and revisions"] = "\n".join((
        *(
            (f"validated_candidate_head = {capsule['validated_candidate_head']}",)
            if capsule["validated_candidate_head"] is not None
            else ()
        ),
        *flat_lines(capsule["dependency_snapshot"]),
        *(
            line
            for fixture in capsule["required_identities"]["fixtures"]
            for line in (
                f"fixture.id = {fixture['id']}",
                f"fixture.content_sha256 = {fixture['content_sha256']}",
            )
        ),
    ))
    content["Environment and tool versions"] = "\n".join(flat_lines(capsule["execution_environment"]))
    final = capsule["final_aggregate"]
    final_lines = (
        (
            *(
                line
                for command in final["commands"]
                for line in (
                    f"final_command.{command['name']} = {shlex.join(command['argv'])}",
                    *(
                        f"final_command.{command['name']}.{key} = {scalar_text(command[key])}"
                        for key in ("outcome", "exit_code", "termination", "spawn_error", "duration_ms")
                    ),
                )
            ),
            *flat_lines({"final_aggregate": {key: value for key, value in final.items() if key != "commands"}}),
            f"final_summary_sha256 = {capsule['final_summary_sha256']}",
        )
        if final["status"] != "not_run"
        else ()
    )
    content["Commands and configuration"] = "\n".join((
        f"gate_configuration.argv = {shlex.join(capsule['gate_configuration']['argv'])}",
        *flat_lines(capsule["gate_configuration"]),
        *final_lines,
    ))
    official = capsule["official_v11"]
    if official["status"] != "not_run":
        content["Observed results"] = "\n".join(flat_lines({
            "official_v11": {key: value for key, value in official.items() if key != "status_counts"},
        }))
        content["Coverage and failures"] = "\n".join(flat_lines({
            "official_v11": {"status_counts": official["status_counts"]},
        }))
    audit_lines = (
        flat_lines({"credential_retention_audit": capsule["credential_retention_audit"]})
        if capsule["credential_retention_audit"]["status"] != "not_run"
        else []
    )
    content["Privacy and external transmission"] = "\n".join((
        *flat_lines({"external_transmission": capsule["gate_configuration"]["external_transmission"]}),
        *(f"external_transmission.scope = {target}" for target in capsule["gate_configuration"]["external_transmission"]["scope"]),
        *audit_lines,
    ))
    content["Acceptance results"] = "\n".join((
        *flat_lines({
            "admission_status": capsule["admission_status"],
            "blocking_classification": capsule["blocking_classification"],
            "evidence_archive": capsule["evidence_archive"],
            "phase_8_ready": capsule["phase_8_ready"],
        }),
        *(
            f"admission_check.{value['name']}.status = {value['status']}"
            for value in capsule["admission_checks"]
        ),
        *(
            (
                "pre_final_candidate_check.status = "
                f"{capsule['pre_final_candidate_check']['status']}",
            )
            if capsule["pre_final_candidate_check"] is not None
            else ()
        ),
        *(
            line
            for outcome in capsule["authenticated_codex_outcomes"]
            for line in (
                f"authenticated_codex_outcomes.target = {outcome['target']}",
                f"authenticated_codex_outcomes.{outcome['target']}.status = {outcome['status']}",
                f"authenticated_codex_outcomes.{outcome['target']}.classification = {outcome['classification']}",
            )
        ),
    ))
    if official["status"] != "not_run":
        content["Decision revisit trigger status"] = "\n".join((
            f"active_decision_revisit_triggers = {scalar_text(capsule['active_decision_revisit_triggers'])}",
            f"decision_revisit_trigger_assessment = {capsule['decision_revisit_trigger_assessment']}",
            *flat_lines(capsule["decision_revisit_trigger_source"], "decision_revisit_trigger_source"),
            "decision_revisit_trigger_source.assessed_decision_ids = "
            f"{scalar_text(capsule['decision_revisit_trigger_source']['assessed_decision_ids'])}",
        ))
    return "# V11 — Semantic checker self-test\n\n" + "\n\n".join(
        f"## {section}\n\n{content[section]}" for section in SECTIONS
    ) + "\n"


def self_test() -> int:
    fully_passed = self_test_capsule()
    fully_passed_report = self_test_report(fully_passed)
    assert check_shape_text(fully_passed_report) == []
    assert check_capsule_semantics(fully_passed_report, fully_passed) == []

    def without_official_v11(capsule: dict[str, Any]) -> None:
        capsule["official_v11"] = {
            "status": "not_run",
            "result_sha256": None,
            "required_step_count": 0,
            "status_counts": {},
            "phase_8_ready": False,
        }
        capsule["credential_retention_audit"] = {
            "status": "not_run",
            "auth_named_file_count": 0,
            "credential_content_match_count": 0,
            "scan_error_count": 0,
        }
        capsule["authenticated_codex_outcomes"] = []
        capsule["active_decision_revisit_triggers"] = None
        capsule["decision_revisit_trigger_assessment"] = "not_run"
        capsule["decision_revisit_trigger_source"] = None
        capsule["evidence_archive"]["prerequisites_passed"] = False
        capsule["phase_8_ready"] = False

    admission_blocked = copy.deepcopy(fully_passed)
    admission_blocked["admission_status"] = "blocked"
    admission_blocked["blocking_classification"] = "authorization_blocked"
    admission_blocked["admission_checks"][1]["status"] = "authorization_blocked"
    admission_blocked["pre_final_candidate_check"] = None
    admission_blocked["gate_configuration"]["authorization_assertion_id"] = None
    admission_blocked["gate_configuration"]["argv"] = admission_blocked[
        "gate_configuration"
    ]["argv"][:-2]
    admission_blocked["gate_configuration"]["same_session_artifact_flow"] = {
        key: False for key in FLOW_KEYS
    }
    admission_blocked["final_aggregate"] = {
        "status": "not_run", "command_count": 0, "failure_count": 0, "commands": [],
    }
    admission_blocked["final_summary_sha256"] = None
    without_official_v11(admission_blocked)
    assert check_capsule_semantics(
        self_test_report(admission_blocked), admission_blocked
    ) == []

    impossible_admission = copy.deepcopy(admission_blocked)
    impossible_admission["phase_8_ready"] = True
    assert any(
        "phase_8_ready" in error
        for error in capsule_contract_errors(impossible_admission)
    )

    final_failed = copy.deepcopy(fully_passed)
    without_official_v11(final_failed)
    final_failed["blocking_classification"] = "final_failed"
    final_failed["gate_configuration"]["same_session_artifact_flow"] = {
        FLOW_KEYS[0]: True,
        FLOW_KEYS[1]: False,
        FLOW_KEYS[2]: False,
    }
    final_failed["final_aggregate"]["status"] = "failed"
    final_failed["final_aggregate"]["failure_count"] = 1
    final_failed["final_aggregate"]["commands"][0].update({
        "outcome": "failed", "exit_code": 9,
    })
    assert check_capsule_semantics(self_test_report(final_failed), final_failed) == []

    impossible_final = copy.deepcopy(final_failed)
    impossible_final["official_v11"] = copy.deepcopy(fully_passed["official_v11"])
    impossible_final["authenticated_codex_outcomes"] = copy.deepcopy(
        fully_passed["authenticated_codex_outcomes"]
    )
    impossible_final["gate_configuration"]["same_session_artifact_flow"][FLOW_KEYS[2]] = True
    assert any(
        "final failure" in error or "artifact flow" in error
        for error in capsule_contract_errors(impossible_final)
    )

    preflight_failed = copy.deepcopy(fully_passed)
    without_official_v11(preflight_failed)
    preflight_failed["blocking_classification"] = "v11_preflight_failed"
    preflight_failed["gate_configuration"]["same_session_artifact_flow"] = {
        FLOW_KEYS[0]: True,
        FLOW_KEYS[1]: True,
        FLOW_KEYS[2]: False,
    }
    assert check_capsule_semantics(
        self_test_report(preflight_failed), preflight_failed
    ) == []

    official_failed = copy.deepcopy(fully_passed)
    official_failed["blocking_classification"] = "v11_failed"
    official_failed["official_v11"].update({
        "status": "failed",
        "required_step_count": 2,
        "status_counts": {"passed": 1, "failed": 1},
        "phase_8_ready": False,
    })
    official_failed["authenticated_codex_outcomes"] = [
        {"target": "volicord", "status": "passed", "classification": "passed"},
        {"target": "small-python", "status": "failed", "classification": "failed"},
    ]
    official_failed["evidence_archive"]["prerequisites_passed"] = False
    official_failed["phase_8_ready"] = False
    assert check_capsule_semantics(
        self_test_report(official_failed), official_failed
    ) == []

    active_trigger = copy.deepcopy(official_failed)
    active_trigger["active_decision_revisit_triggers"] = ["Q3"]
    assert check_capsule_semantics(
        self_test_report(active_trigger), active_trigger
    ) == []

    unassessable = copy.deepcopy(official_failed)
    unassessable["active_decision_revisit_triggers"] = None
    unassessable["decision_revisit_trigger_assessment"] = (
        "official_v11_assessment_failed"
    )
    unassessable["decision_revisit_trigger_source"] = {
        "kind": "accepted_decision_register",
        "path": "rebuild/docs/design/open-decisions.md",
        "content_sha256": "2" * 64,
        "assessed_decision_ids": [],
        "assessed_decision_count": 0,
    }
    assert check_capsule_semantics(
        self_test_report(unassessable), unassessable
    ) == []

    missing_revisit_evidence = copy.deepcopy(fully_passed)
    missing_revisit_evidence["active_decision_revisit_triggers"] = None
    missing_revisit_evidence["decision_revisit_trigger_assessment"] = (
        "official_v11_assessment_failed"
    )
    assert any(
        "revisit" in error or "assessment" in error
        for error in capsule_contract_errors(missing_revisit_evidence)
    )

    archive_failed = copy.deepcopy(fully_passed)
    archive_failed["blocking_classification"] = "evidence_archive_verification_failed"
    archive_failed["evidence_archive"]["status"] = "verification_failed"
    archive_failed["evidence_archive"]["verification_status"] = "failed"
    archive_failed["phase_8_ready"] = False
    assert check_capsule_semantics(
        self_test_report(archive_failed), archive_failed
    ) == []
    missing_archive = copy.deepcopy(fully_passed)
    missing_archive.pop("evidence_archive")
    assert any(
        "evidence_archive" in error
        for error in capsule_contract_errors(missing_archive)
    )

    missing_version = fully_passed_report.replace(
        "cargo 1.2.3", "version omitted from report"
    )
    version_errors = check_capsule_semantics(missing_version, fully_passed)
    assert any("tools.cargo.version" in error for error in version_errors)

    command = fully_passed["final_aggregate"]["commands"][0]
    command_text = shlex.join(command["argv"])
    missing_argv = fully_passed_report.replace(command_text, "command vector omitted")
    argv_errors = check_capsule_semantics(missing_argv, fully_passed)
    assert any(f"final_command.{command['name']}" in error for error in argv_errors)

    incomplete_capsule = copy.deepcopy(fully_passed)
    incomplete_capsule["execution_environment"]["platform"]["release"] = None
    assert any(
        "platform.release" in error
        for error in capsule_contract_errors(incomplete_capsule)
    )
    incomplete_capsule = copy.deepcopy(fully_passed)
    incomplete_capsule["execution_environment"]["tools"]["rustc"]["version"] = None
    assert any("tools.rustc.version" in error for error in capsule_contract_errors(incomplete_capsule))
    incomplete_capsule = copy.deepcopy(fully_passed)
    incomplete_capsule["dependency_snapshot"]["cargo_lock"]["sha256"] = None
    assert any("cargo_lock.sha256" in error for error in capsule_contract_errors(incomplete_capsule))
    incomplete_capsule = copy.deepcopy(fully_passed)
    incomplete_capsule["final_aggregate"]["commands"][0]["argv"] = []
    assert any("final command argv" in error for error in capsule_contract_errors(incomplete_capsule))

    with tempfile.TemporaryDirectory(prefix="validation-report-checker-self-test-") as directory:
        path = Path(directory) / "generic-report.md"
        path.write_text(fully_passed_report, encoding="utf-8")
        assert check(path) == []
        external_capsule = Path(directory) / "copied-capsule.json"
        capsule_bytes = (json.dumps(fully_passed, sort_keys=True) + "\n").encode("utf-8")
        external_capsule.write_bytes(capsule_bytes)
        external_value = copied_capsule(external_capsule)
        assert external_value == fully_passed
        assert check_capsule_semantics(fully_passed_report, external_value) == []
        ignored_parent = REPOSITORY_ROOT / "rebuild/.local/validation"
        ignored_parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(
            prefix="report-capsule-boundary-self-test-", dir=ignored_parent
        ) as ignored_directory:
            ignored_capsule = Path(ignored_directory) / "capsule.json"
            ignored_capsule.write_bytes(capsule_bytes)
            assert ignored_capsule.read_bytes() == external_capsule.read_bytes()
            try:
                copied_capsule(ignored_capsule)
            except ValueError as error:
                assert "explicit copy" in str(error)
            else:
                raise AssertionError("ignored local capsule was accepted")
    print(
        "validation report checker self-test passed; lifecycle scenarios: 7; "
        "copied-capsule boundary: passed"
    )
    return 0


def parse_args(arguments: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="rebuild/scripts/check-validation-report",
        description="Check maintained report shape and optional capsule-backed V11 semantics.",
    )
    parser.add_argument("report", nargs="?", type=Path)
    parser.add_argument("--capsule", type=Path)
    parser.add_argument("--self-test", action="store_true")
    return parser.parse_args(arguments)


def main(arguments: Sequence[str]) -> int:
    args = parse_args(arguments)
    if args.self_test:
        if args.report is not None or args.capsule is not None:
            print("--self-test does not accept report or capsule arguments", file=sys.stderr)
            return 2
        try:
            return self_test()
        except (AssertionError, OSError, ValueError, json.JSONDecodeError) as error:
            print(f"validation report checker self-test failed: {error}", file=sys.stderr)
            return 1
    if args.report is None:
        print("a report path is required", file=sys.stderr)
        return 2
    if not args.report.is_file():
        print(f"report does not exist: {args.report}", file=sys.stderr)
        return 2
    errors = check(args.report)
    if args.capsule is not None:
        if not args.capsule.is_file():
            print(f"capsule does not exist: {args.capsule}", file=sys.stderr)
            return 2
        try:
            capsule = copied_capsule(args.capsule)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            print(f"capsule input is invalid: {error}", file=sys.stderr)
            return 2
        errors.extend(check_capsule_semantics(args.report.read_text(encoding="utf-8"), capsule))
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1
    mode = "capsule-backed semantics" if args.capsule is not None else "shape"
    print(f"validation report {mode} passed: {args.report}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
