)


def tracked_paths(root: Path) -> list[str]:
    completed = subprocess.run(
        ("git", "-C", str(root), "ls-files"),
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if completed.returncode != 0:
        raise RuntimeError(f"git ls-files failed: {completed.stderr.strip()}")
    return completed.stdout.splitlines()


def section(text: str, heading: str) -> str:
    start = text.find(heading)
    if start < 0:
        return ""
    following = text.find("\n## ", start + len(heading))
    return text[start:] if following < 0 else text[start:following]


def heading_section(text: str, heading: str) -> str:
    """Return one Markdown heading and its content through the next peer/parent heading."""
    start = text.find(heading)
    if start < 0:
        return ""
    level = len(heading) - len(heading.lstrip("#"))
    following = re.search(rf"^#{{1,{level}}} ", text[start + len(heading) :], re.MULTILINE)
    if following is None:
        return text[start:]
    end = start + len(heading) + following.start()
    return text[start:end]


def table_first_cells(text: str) -> list[str]:
    cells: list[str] = []
    for line in text.splitlines():
        if not line.startswith("|"):
            continue
        parts = [part.strip() for part in line.strip().strip("|").split("|")]
        if not parts or parts[0] in {"", "---", "Decision", "Scenario", "Validation"}:
            continue
        if set(parts[0]) == {"-"}:
            continue
        cells.append(parts[0])
    return cells


def table_rows(text: str, headers: tuple[str, ...]) -> list[dict[str, str]]:
    """Return rows from one table identified by its compact header contract."""
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if not line.startswith("|"):
            continue
        cells = tuple(part.strip() for part in line.strip().strip("|").split("|"))
        if cells != headers:
            continue
        if index + 1 >= len(lines) or not lines[index + 1].startswith("|"):
            return []
        rows: list[dict[str, str]] = []
        for row_line in lines[index + 2 :]:
            if not row_line.startswith("|"):
                break
            values = tuple(part.strip() for part in row_line.strip().strip("|").split("|"))
            if len(values) != len(headers):
                break
            rows.append(dict(zip(headers, values, strict=True)))
        return rows
    return []


def unquote_code(value: str) -> str:
    return value[1:-1] if value.startswith("`") and value.endswith("`") else value


def indexed_rows(rows: list[dict[str, str]], key: str) -> dict[str, dict[str, str]]:
    return {unquote_code(row[key]): row for row in rows}


def require_row_keys(
    errors: list[str],
    document: str,
    rows: list[dict[str, str]],
    key: str,
    required: tuple[str, ...],
    contract: str,
) -> dict[str, dict[str, str]]:
    indexed = indexed_rows(rows, key)
    for item in required:
        if item not in indexed:
            errors.append(f"{document}: missing {contract}: {item}")
    return indexed


def require_markers(
    errors: list[str], document: str, text: str, markers: tuple[str, ...], contract: str
) -> None:
    for marker in markers:
        if marker not in text:
            errors.append(f"{document}: missing {contract}: {marker}")


def markdown_files(root: Path, tracked: Iterable[str]) -> list[Path]:
    selected: list[Path] = []
    for relative in tracked:
        if relative in {"AGENTS.md", "rebuild/AGENTS.md"} or (
            relative.endswith(".md")
            and (
                relative.startswith("rebuild/docs/design/")
                or relative.startswith("rebuild/validation/")
            )
        ):
            path = root / relative
            if path.is_file():
                selected.append(path)
    return selected


def check_links(root: Path, paths: Iterable[Path]) -> list[str]:
    errors: list[str] = []
    link_pattern = re.compile(r"\[[^]]+\]\(([^)]+)\)")
    for path in paths:
        text = path.read_text(encoding="utf-8")
        for target in link_pattern.findall(text):
            if "://" in target or target.startswith("#"):
                continue
            relative = target.split("#", 1)[0]
            if relative and not (path.parent / relative).resolve().exists():
                errors.append(f"{path.relative_to(root)}: unresolved relative link: {target}")
    return errors


def check_documents(root: Path) -> list[str]:
    errors: list[str] = []
    for name in ARCHITECTURE_DOCUMENTS:
        path = root / DESIGN_DIRECTORY / name
        if not path.is_file():
            errors.append(f"missing architecture document: {path.relative_to(root)}")
            continue
        text = path.read_text(encoding="utf-8")
        for declaration in ("- 상태: active", "- 소유 범위:", "- 비소유 범위:"):
            if declaration not in text:
                errors.append(f"{path.relative_to(root)}: missing ownership declaration: {declaration}")
        for heading in REQUIRED_HEADINGS[name]:
            if text.splitlines().count(heading) != 1:
                errors.append(f"{path.relative_to(root)}: expected one heading: {heading}")
        match = PLACEHOLDER_PATTERN.search(text)
        if match:
            errors.append(f"{path.relative_to(root)}: active placeholder: {match.group(0)}")
    return errors


def check_owner_routing(root: Path) -> list[str]:
    errors: list[str] = []
    root_agents = (root / "AGENTS.md").read_text(encoding="utf-8")
    rebuild_agents = (root / "rebuild/AGENTS.md").read_text(encoding="utf-8")
    inputs_path = root / DESIGN_DIRECTORY / "architecture-inputs.md"
    inputs = inputs_path.read_text(encoding="utf-8")

    owner_pattern = re.compile(r"^\| `active` \| \[[^]]+\.md\]\(([^)]+\.md)\) \|", re.MULTILINE)
    owners = owner_pattern.findall(inputs)
    expected = set(ARCHITECTURE_DOCUMENTS)
    if len(owners) != len(ARCHITECTURE_DOCUMENTS):
        errors.append(f"architecture-inputs.md: expected 9 active owner rows, found {len(owners)}")
    duplicates = sorted({name for name in owners if owners.count(name) > 1})
    if duplicates:
        errors.append(f"architecture-inputs.md: duplicate architecture owner: {', '.join(duplicates)}")
    missing = sorted(expected - set(owners))
    extra = sorted(set(owners) - expected)
    if missing:
        errors.append(f"architecture-inputs.md: missing active owners: {', '.join(missing)}")
    if extra:
        errors.append(f"architecture-inputs.md: unexpected active owners: {', '.join(extra)}")

    for name in ARCHITECTURE_DOCUMENTS:
        full = f"rebuild/docs/design/{name}"
        route_pattern = re.compile(rf"`{re.escape(full)}` owns (?:the )?active")
        if not route_pattern.search(root_agents):
            errors.append(f"AGENTS.md: missing active owner route: {full}")
        if full not in rebuild_agents:
            errors.append(f"rebuild/AGENTS.md: missing required read route: {full}")
        planned_pattern = re.compile(rf"\| `planned` \| (?:`|\[[^]]+\]\(){re.escape(name)}")
        if planned_pattern.search(inputs):
            errors.append(f"architecture-inputs.md: active owner remains planned: {name}")
    return errors


def check_traceability(root: Path) -> list[str]:
    errors: list[str] = []
    architecture_path = root / DESIGN_DIRECTORY / "architecture.md"
    text = architecture_path.read_text(encoding="utf-8")

    decision_cells = table_first_cells(section(text, "## 8. Accepted Decision traceability contract"))
    expected_decisions = (*DECISION_IDS, *QUESTION_IDS)
    for identifier in expected_decisions:
        count = decision_cells.count(identifier)
        if count != 1:
            errors.append(f"architecture.md: expected one traceability row for {identifier}, found {count}")

    acceptance_cells = table_first_cells(section(text, "## 9. Acceptance scenario traceability contract"))
    for identifier in ACCEPTANCE_IDS:
        count = acceptance_cells.count(identifier)
        if count != 1:
            errors.append(f"architecture.md: expected one acceptance row for {identifier}, found {count}")

    validation_cells = table_first_cells(section(text, "## 10. Later-validation interface traceability"))
    for identifier in LATER_VALIDATION_IDS:
        count = validation_cells.count(identifier)
        if count != 1:
            errors.append(f"architecture.md: expected one later-validation row for {identifier}, found {count}")

    for concept in PHASE_4_HANDOFF:
        if concept not in section(text, "## 7. Phase 4 responsibility handoff"):
            errors.append(f"architecture.md: missing Phase 4 handoff concept: {concept}")
    return errors


def check_relation_direction_contract(root: Path) -> list[str]:
    errors: list[str] = []
    document = "domain-model.md"
    text = (root / DESIGN_DIRECTORY / document).read_text(encoding="utf-8")
    rows = table_rows(
        section(text, "## 8. Canonical relation"),
        ("Relation", "From", "To", "Domain meaning"),
    )
    indexed = indexed_rows(rows, "Relation")

    expected = {
        "supported_by": (
            "statement-bearing record, Decision rationale 또는 Checkpoint observation",
            "supporting Source",
        ),
        "derived_from": (
            "Session Candidate, Derived State 또는 generated explanation",
            "Source 또는 canonical basis used",
        ),
    }
    for relation, (expected_from, expected_to) in expected.items():
        row = indexed.get(relation)
        if row is None:
            errors.append(f"{document}: missing canonical relation direction: {relation}")
            continue
        actual_from = row["From"]
        actual_to = row["To"]
        if relation == "supported_by" and "Source" in actual_from and any(
            marker in actual_to for marker in ("statement", "Decision", "Checkpoint")
        ):
            errors.append(f"{document}: reversed supported_by direction")
        if relation == "derived_from" and (
            actual_from.startswith("Source") or actual_from.startswith("canonical basis")
        ) and any(marker in actual_to for marker in ("Candidate", "Derived", "explanation")):
            errors.append(f"{document}: reversed derived_from direction")
        if actual_from != expected_from or actual_to != expected_to:
            errors.append(
                f"{document}: invalid {relation} direction; expected {expected_from} -> {expected_to}"
            )
    return errors


def check_candidate_contract(root: Path) -> list[str]:
    errors: list[str] = []
    domain_document = "domain-model.md"
    domain_text = (root / DESIGN_DIRECTORY / domain_document).read_text(encoding="utf-8")
    domain_section = section(domain_text, "## 2. Information class")
    metadata_rows = table_rows(domain_section, ("Attribute", "Required meaning"))
    require_row_keys(
        errors,
        domain_document,
        metadata_rows,
        "Attribute",
        CANDIDATE_METADATA_ATTRIBUTES,
        "Candidate metadata attribute",
    )
    lifecycle_rows = table_rows(domain_section, ("Disposition", "Meaning"))
    require_row_keys(
        errors,
        domain_document,
        lifecycle_rows,
        "Disposition",
        CANDIDATE_DISPOSITIONS,
        "Candidate lifecycle disposition",
    )

    projection_document = "projections-and-documents.md"
    projection_text = (root / DESIGN_DIRECTORY / projection_document).read_text(encoding="utf-8")
    projection_section = section(projection_text, "### Candidate Inspection projection contract")
    inspection_rows = table_rows(
        projection_section, ("Inspectable attribute", "Projection obligation")
    )
    require_row_keys(
        errors,
        projection_document,
        inspection_rows,
        "Inspectable attribute",
        CANDIDATE_INSPECTION_ATTRIBUTES,
        "Candidate Inspection attribute",
    )
    require_markers(
        errors,
        projection_document,
        projection_section,
        (
            "named,",
            "read-only projection",
            "promote, correct, dismiss, expire, delete 또는",
            "Inspection failure는 projection degradation",
        ),
        "Candidate Inspection read-only/degradation behavior",
    )
    if "projections, Candidate Inspection," not in projection_text:
        errors.append(f"{projection_document}: missing Candidate Inspection owner declaration")

    privacy_document = "privacy-and-provider-boundary.md"
    privacy_text = (root / DESIGN_DIRECTORY / privacy_document).read_text(encoding="utf-8")
    privacy_section = section(
        privacy_text, "### Candidate collection opt-out and retention contract"
    )
    privacy_rows = table_rows(privacy_section, ("Concern", "Required behavior"))
    privacy_index = require_row_keys(
        errors,
        privacy_document,
        privacy_rows,
        "Concern",
        CANDIDATE_PRIVACY_CONCERNS,
        "Candidate privacy concern",
    )
    opt_out_row = privacy_index.get("scope_opt_out")
    if opt_out_row is not None and "새 automatic Candidate collection을 중단" not in opt_out_row[
        "Required behavior"
    ]:
        errors.append(f"{privacy_document}: missing Candidate opt-out behavior")
    existing_row = privacy_index.get("existing_candidate_visibility")
    if existing_row is not None:
        for marker in ("explicit deletion", "dismissal", "promotion", "retention expiry"):
            if marker not in existing_row["Required behavior"]:
                errors.append(
                    f"{privacy_document}: incomplete existing Candidate retention behavior: {marker}"
                )
    require_markers(
        errors,
        privacy_document,
        privacy_section,
        (
            "Opt-out은 existing Candidate를 promote, dismiss, expire, delete, correct 또는",
            "Full prompt",
            "full tool argument",
            "full Source body",
            "unlimited stdout/stderr",
        ),
        "Candidate opt-out/retention boundary",
    )
    if "Candidate collection opt-out/retention" not in privacy_text:
        errors.append(f"{privacy_document}: missing Candidate opt-out/retention owner declaration")
    return errors


def check_candidate_inspection_read_authority(root: Path) -> list[str]:
    errors: list[str] = []
    architecture_document = "architecture.md"
    architecture_text = (root / DESIGN_DIRECTORY / architecture_document).read_text(
        encoding="utf-8"
    )

    subsystem_section = heading_section(
        architecture_text, "### 3.4 Projections and Documents"
    )
    subsystem_description = subsystem_section.split(
        "#### Candidate Inspection read authority contract", 1
    )[0]
    subsystem_markers = (
        "정확히 다음 세 logical input class",
        "Canonical Context read model",
        "Candidate Inspection",
        "domain과 privacy policy가 허용한",
        "bounded Session Candidate metadata",
        "permitted Derived State",
    )
    subsystem_grants_candidate = all(
        marker in subsystem_description for marker in subsystem_markers
    )
    if not subsystem_grants_candidate:
        errors.append(
            f"{architecture_document}: missing Projections subsystem Candidate Inspection read authority"
        )

    boundary_rows = table_rows(
        section(architecture_text, "## 4. Boundary authority"),
        ("Subsystem", "Read authority", "Write authority", "Reference authority"),
    )
    boundary_index = indexed_rows(boundary_rows, "Subsystem")
    projection_row = boundary_index.get("Projections and Documents")
    boundary_markers = (
        "Canonical Context read model",
        "Candidate Inspection에만",
        "domain/privacy-policy-authorized",
        "bounded Session Candidate metadata",
        "permitted Derived State",
    )
    boundary_grants_candidate = projection_row is not None and all(
        marker in projection_row["Read authority"] for marker in boundary_markers
    )
    if not boundary_grants_candidate:
        errors.append(
            f"{architecture_document}: Boundary authority row missing Candidate Inspection read authority"
        )

    authority_section = heading_section(
        architecture_text, "#### Candidate Inspection read authority contract"
    )
    authority_rows = table_rows(
        authority_section, ("Contract field", "Required authority boundary")
    )
    authority_index = require_row_keys(
        errors,
        architecture_document,
        authority_rows,
        "Contract field",
        CANDIDATE_READ_AUTHORITY_FIELDS,
        "Candidate Inspection read authority field",
    )

    reader = authority_index.get("reader", {}).get("Required authority boundary", "")
    purpose = authority_index.get("purpose", {}).get("Required authority boundary", "")
    if reader != "Projections and Documents" or purpose != "Candidate Inspection only":
        errors.append(f"{architecture_document}: invalid Candidate Inspection reader/purpose")

    input_class = authority_index.get("input_information_class", {}).get(
        "Required authority boundary", ""
    )
    input_class_markers = (
        "Session Candidate remains Session Candidate",
        "not reclassified as Derived State",
    )
    input_is_session_candidate = all(marker in input_class for marker in input_class_markers)
    if not input_is_session_candidate:
        errors.append(
            f"{architecture_document}: Candidate Inspection input is not distinct Session Candidate"
        )

    allowed_read = authority_index.get("allowed_read", {}).get(
        "Required authority boundary", ""
    )
    allowed_read_markers = (
        "`domain-model.md`",
        "user-inspectable Candidate metadata",
        "collection",
        "retention",
        "deletion",
        "privacy policy",
        "bounded Candidate content",
    )
    bounded_policy_scope = all(marker in allowed_read for marker in allowed_read_markers)
    if not bounded_policy_scope:
        errors.append(
            f"{architecture_document}: missing bounded domain/privacy Candidate read scope"
        )

    policy_owners = authority_index.get("policy_owners", {}).get(
        "Required authority boundary", ""
    )
    for marker in (
        "`domain-model.md`",
        "`privacy-and-provider-boundary.md`",
        "`projections-and-documents.md`",
        "identity, meaning, lifecycle",
        "collection scope, opt-out, retention, expiry와 deletion",
        "presentation과 omission",
    ):
        if marker not in policy_owners:
            errors.append(
                f"{architecture_document}: incomplete Candidate Inspection policy ownership: {marker}"
            )

    forbidden_access = authority_index.get("forbidden_access", {}).get(
        "Required authority boundary", ""
    )
    for marker in (
        "Full prompts",
        "full tool arguments",
        "full Source bodies",
        "unlimited stdout/stderr",
        "provider-private payloads",
        "expired or deleted Candidate content",
        "authorized Project/scope 밖의 content",
        "blanket read authority가 없다",
    ):
        if marker not in forbidden_access:
            errors.append(
                f"{architecture_document}: incomplete Candidate Inspection forbidden access: {marker}"
            )
    for pattern in OVERBROAD_CANDIDATE_ACCESS_PATTERNS:
        if pattern.search(authority_section):
            errors.append(f"{architecture_document}: grants unrestricted Candidate-body access")

    mutation_boundary = authority_index.get("mutation_boundary", {}).get(
        "Required authority boundary", ""
    )
    mutation_markers = (
        "Read, omission, ranking, rendering, expansion 또는 inspection failure",
        "promote, dismiss, expire, delete, correct, reinterpret",
        "retention/opt-out state를 바꿀 수 없다",
    )
    no_mutation = all(marker in mutation_boundary for marker in mutation_markers)
    if not no_mutation:
        errors.append(
            f"{architecture_document}: missing Candidate Inspection no-mutation behavior"
        )

    failure_boundary = authority_index.get("failure_boundary", {}).get(
        "Required authority boundary", ""
    )
    failure_markers = (
        "Unavailable 또는 policy-withheld Candidate content",
        "bounded `partial`/`degraded` inspection",
        "explicit omission basis",
        "Empty success",
        "Canonical mutation",
    )
    degraded_failure = all(marker in failure_boundary for marker in failure_markers)
    if not degraded_failure:
        errors.append(
            f"{architecture_document}: missing Candidate Inspection partial/degraded failure boundary"
        )

    producer_independence = authority_index.get("producer_independence", {}).get(
        "Required authority boundary", ""
    )
    for marker in ("identity와 provenance", "write authority를 얻지 않는다"):
        if marker not in producer_independence:
            errors.append(
                f"{architecture_document}: incomplete Candidate producer independence: {marker}"
            )

    implementation_neutrality = authority_index.get("implementation_neutrality", {}).get(
        "Required authority boundary", ""
    )
    for marker in ("database", "unified service", "API", "process", "transport"):
        if marker not in implementation_neutrality:
            errors.append(
                f"{architecture_document}: incomplete Candidate implementation neutrality: {marker}"
            )

    domain_document = "domain-model.md"
    domain_text = (root / DESIGN_DIRECTORY / domain_document).read_text(encoding="utf-8")
    domain_information = section(domain_text, "## 2. Information class")
    domain_separates_candidate = all(
        marker in domain_text or marker in domain_information
        for marker in (
            "`Canonical Context`, `Session Candidate`, `Derived State`는 서로 다른",
            "### 2.2 Session Candidate",
            "### 2.3 Derived State",
        )
    )
    if not domain_separates_candidate:
        errors.append(f"{domain_document}: Session Candidate is not separate from Derived State")

    projection_document = "projections-and-documents.md"
    projection_text = (root / DESIGN_DIRECTORY / projection_document).read_text(encoding="utf-8")
    projection_intro = " ".join(
        projection_text.split("## 1. Projection invariant", 1)[0].split()
    )
    projection_invariants = " ".join(
        heading_section(projection_text, "## 1. Projection invariant").split()
    )
    projection_candidate = " ".join(
        heading_section(
            projection_text, "### Candidate Inspection projection contract"
        ).split()
    )
    specialized_markers = (
        "Canonical Context",
        "bounded Session Candidate metadata",
        "Candidate Inspection에만",
        "permitted Derived State",
    )
    if not all(marker in projection_intro for marker in specialized_markers):
        errors.append(
            f"{projection_document}: introductory read boundary exceeds top-level authority"
        )
    if not all(marker in projection_invariants for marker in specialized_markers):
        errors.append(
            f"{projection_document}: Projection invariant exceeds top-level authority"
        )
    specialized_scope_markers = (
        "user-inspectable Candidate metadata",
        "collection, retention, deletion 및 privacy policy",
        "bounded Candidate",
        "Full prompts",
        "full tool arguments",
        "full Source bodies",
        "unlimited",
        "provider-private payloads",
        "blanket authority가 아니다",
    )
    if not all(marker in projection_candidate for marker in specialized_scope_markers):
        errors.append(
            f"{projection_document}: Candidate Inspection does not preserve bounded top-level scope"
        )
    for pattern in OVERBROAD_CANDIDATE_ACCESS_PATTERNS:
        if pattern.search(projection_text):
            errors.append(
                f"{projection_document}: claims unrestricted Candidate-body access"
            )

    top_level_grants_candidate = all(
        (
            subsystem_grants_candidate,
            boundary_grants_candidate,
            reader == "Projections and Documents",
            purpose == "Candidate Inspection only",
            input_is_session_candidate,
            bounded_policy_scope,
            no_mutation,
            degraded_failure,
        )
    )
    specialized_claims_candidate = (
        "Session Candidate를 읽는 named," in projection_candidate
        and "read-only projection" in projection_candidate
    )
    if specialized_claims_candidate and not top_level_grants_candidate:
        errors.append(
            f"{projection_document}: Candidate Inspection exceeds top-level architecture authority"
        )
    return errors


def check_guarded_effect_contract(root: Path) -> list[str]:
    errors: list[str] = []
    architecture_document = "architecture.md"
    architecture_text = (root / DESIGN_DIRECTORY / architecture_document).read_text(
        encoding="utf-8"
    )
    guarded_section = section(architecture_text, "#### Guarded-effect confirmation contract")
    field_rows = table_rows(
        guarded_section, ("Confirmation request field", "Required meaning")
    )
    require_row_keys(
        errors,
        architecture_document,
        field_rows,
        "Confirmation request field",
        GUARDED_CONFIRMATION_FIELDS,
        "Guarded confirmation field",
    )
    outcome_rows = table_rows(guarded_section, ("Guarded operation outcome", "Meaning"))
    require_row_keys(
        errors,
        architecture_document,
        outcome_rows,
        "Guarded operation outcome",
        GUARDED_OPERATION_OUTCOMES,
        "Guarded operation outcome",
    )
    require_markers(
        errors,
        architecture_document,
        guarded_section,
        (
            "Ordinary code edit, local test, local repository inventory와 local structural analysis",
            "Guarded boundary 밖이며 confirmation 때문에 block되지 않는다",
            "`Source`-linked response",
            "general product `Decision`",
            "action-scoped, target-scoped, scope-scoped, expiring, non-transferable이며",
            "single-use",
            "Dispatch 전에 Local Operations",
            "request revision, exact action, target,",
            "expected effect, scope, expiration과 effect fingerprint가 current Candidate와 일치",
            "consumed confirmation의 reuse는 reject한다",
            "Valid confirmation 전에는 external 또는 그 밖의 Guarded effect를 dispatch하지 않는다",
            "Derived/operational state이고 새 canonical",
            "일곱 번째\ncanonical core entity로 만들지 않는다",
            "cooperative confirmation",
            "OS sandbox 또는 security enforcement가",
        ),
        "Guarded confirmation behavior",
    )
    require_markers(
        errors,
        architecture_document,
        architecture_text,
        (
            "현재 host의 explicit Guarded confirmation request/response transport",
            "local viewer 또는 CLI",
            "Local Operations는 Guarded effect dispatch와 exact confirmation validation의 logical",
        ),
        "Guarded current-host/fallback/dispatch ownership",
    )
    if "`Source`-linked response" not in guarded_section:
        errors.append(f"{architecture_document}: missing Guarded user-response Source linkage")
    if "consumed confirmation의 reuse는 reject한다" not in guarded_section:
        errors.append(f"{architecture_document}: missing confirmation reuse rejection")

    failure_document = "failure-and-recovery.md"
    failure_text = (root / DESIGN_DIRECTORY / failure_document).read_text(encoding="utf-8")
    failure_section = section(
        failure_text, "### Guarded confirmation and execution failure contract"
    )
    failure_rows = table_rows(
        failure_section, ("Confirmation/execution condition", "Required result")
    )
    require_row_keys(
        errors,
        failure_document,
        failure_rows,
        "Confirmation/execution condition",
        GUARDED_FAILURE_CONDITIONS,
        "Guarded failure condition",
    )
    no_dispatch_marker = (
        "Guarded effect는 valid exact-match confirmation의 pre-dispatch validation보다 먼저\n"
        "   dispatch되지 않는다."
    )
    if no_dispatch_marker not in failure_text:
        errors.append(f"{failure_document}: missing no-dispatch-before-confirmation rule")
    require_markers(
        errors,
        failure_document,
        failure_section,
        (
            "silently retry하지 않음",
            "`repair_required`",
            "Cooperative confirmation",
            "OS sandbox나",
            "security enforcement",
        ),
        "Guarded indeterminate/cooperative failure behavior",
    )
    return errors


def check_corrected_traceability(root: Path) -> list[str]:
    errors: list[str] = []
    document = "architecture.md"
    text = (root / DESIGN_DIRECTORY / document).read_text(encoding="utf-8")
    decisions = indexed_rows(
        table_rows(
            section(text, "## 8. Accepted Decision traceability contract"),
            ("Decision", "Authoritative architecture owner", "Owned interface"),
        ),
        "Decision",
    )
    acceptances = indexed_rows(
        table_rows(
            section(text, "## 9. Acceptance scenario traceability contract"),
            (
                "Scenario",
                "Owning architecture document",
                "Future implementation phase",
                "Owning later validation",
            ),
        ),
        "Scenario",
    )
    validations = indexed_rows(
        table_rows(
            section(text, "## 10. Later-validation interface traceability"),
            ("Validation", "Owning Phase 3 interface", "Precise contract validated later"),
        ),
        "Validation",
    )

    expected_decisions = {
        "Q10": ("`domain-model.md`", ("inspection", "Privacy")),
        "Q12": ("`architecture.md`", ("Source-linked", "pre-dispatch")),
    }
    for identifier, (owner, markers) in expected_decisions.items():
        row = decisions.get(identifier)
        if row is None:
            continue
        if row["Authoritative architecture owner"] != owner:
            errors.append(f"{document}: incorrect {identifier} primary owner")
        for marker in markers:
            if marker not in row["Owned interface"]:
                errors.append(f"{document}: incomplete {identifier} corrected-owner routing: {marker}")

    expected_acceptance_validations = {
        "G": ("V07", "V09", "V11"),
        "K": ("V04", "V07"),
        "M": ("V08", "V11"),
    }
    expected_acceptance_owners = {
        "G": ("`domain-model.md`", "Projection", "Privacy"),
        "K": ("`domain-model.md`", "privacy/deletion"),
        "M": ("`architecture.md`", "fallback", "non-reuse"),
    }
    for identifier, required_validations in expected_acceptance_validations.items():
        row = acceptances.get(identifier)
        if row is None:
            continue
        for validation in required_validations:
            if validation not in row["Owning later validation"]:
                errors.append(
                    f"{document}: Acceptance {identifier} missing validation owner: {validation}"
                )
        for marker in expected_acceptance_owners[identifier]:
            if marker not in row["Owning architecture document"]:
                errors.append(
                    f"{document}: Acceptance {identifier} missing corrected-owner routing: {marker}"
                )

    expected_validation_markers = {
        "V07": ("Candidate collection opt-out/retention", "privacy/deletion propagation"),
        "V08": ("Guarded current-host transport", "viewer/CLI fallback"),
        "V09": ("Candidate promotion/inspection/no-mutation",),
        "V11": ("integrated Candidate journey", "Guarded exact-match/non-reuse/ordinary-action"),
    }
    for identifier, markers in expected_validation_markers.items():
        row = validations.get(identifier)
        if row is None:
            continue
        for marker in markers:
            if marker not in row["Precise contract validated later"]:
                errors.append(f"{document}: {identifier} missing corrected validation contract: {marker}")
    return errors


def check_paths_and_prohibitions(root: Path, tracked: list[str]) -> list[str]:
    errors: list[str] = []
    tracked_set = set(tracked)
    for path in CAPABILITY_REPORT_PATHS:
        if path not in tracked_set or not (root / path).is_file():
            errors.append(f"missing capability-based validation report: {path}")
    for path in tracked:
        if OLD_NUMERIC_VALIDATION_PATH.match(path):
            errors.append(f"tracked old numeric validation source path: {path}")

    active_text = "\n".join(
        (root / DESIGN_DIRECTORY / name).read_text(encoding="utf-8")
        for name in ARCHITECTURE_DOCUMENTS
        if (root / DESIGN_DIRECTORY / name).is_file()
    )
    old_reference = OLD_NUMERIC_VALIDATION_REFERENCE.search(active_text)
    if old_reference:
        errors.append(f"active architecture uses old numeric validation path: {old_reference.group(0)}")
    for pattern in POSITIVE_PROHIBITED_PATH_PATTERNS:
        match = pattern.search(active_text)
        if match:
            errors.append(f"active architecture presents a prohibited supported path: {match.group(0)}")
    for pattern in PRODUCTION_PROTOTYPE_PATTERNS:
        match = pattern.search(active_text)
        if match:
            errors.append(f"Wave 1 prototype named as production implementation: {match.group(0)}")

    version_text = (root / DESIGN_DIRECTORY / "versioning-policy.md").read_text(encoding="utf-8")
    for marker in ("Legacy decoder", "dual read/write", "parallel production implementation", "product-generation label"):
        if marker not in version_text:
            errors.append(f"versioning-policy.md: missing prohibited-path boundary: {marker}")
    return errors


def check_repository(root: Path, known_tracked: list[str] | None = None) -> list[str]:
    tracked = tracked_paths(root) if known_tracked is None else known_tracked
    errors: list[str] = []
    errors.extend(check_documents(root))
    errors.extend(check_links(root, markdown_files(root, tracked)))
    errors.extend(check_owner_routing(root))
    errors.extend(check_traceability(root))
    errors.extend(check_relation_direction_contract(root))
    errors.extend(check_candidate_contract(root))
    errors.extend(check_candidate_inspection_read_authority(root))
    errors.extend(check_guarded_effect_contract(root))
    errors.extend(check_corrected_traceability(root))
    errors.extend(check_paths_and_prohibitions(root, tracked))
    return errors


def copy_self_test_fixture(destination: Path, tracked: list[str]) -> list[str]:
    selected: list[str] = []
    for relative in tracked:
        if relative in {"AGENTS.md", "rebuild/AGENTS.md"} or (
            relative.endswith(".md")
            and (
                relative.startswith("rebuild/docs/design/")
                or relative.startswith("rebuild/validation/")
            )
        ):
            source = REPOSITORY_ROOT / relative
            if source.is_file():
                target = destination / relative
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source, target)
                selected.append(relative)
    return selected


def replace_once(path: Path, old: str, new: str) -> None:
    text = path.read_text(encoding="utf-8")
    if text.count(old) != 1:
        raise AssertionError(f"self-test fixture expected one occurrence in {path}: {old}")
    path.write_text(text.replace(old, new, 1), encoding="utf-8")


def remove_top_level_candidate_read_authority(root: Path, _: list[str]) -> None:
    architecture = root / DESIGN_DIRECTORY / "architecture.md"
    replace_once(
        architecture,
        "- Projections and Documents는 Canonical Context read model, Candidate Inspection에만\n"
        "  허용된 bounded Session Candidate metadata와 permitted Derived State를 읽어 결과를\n"
        "  만들며 read, rendering 또는 export의 side effect로 Candidate나 canonical record를\n"
        "  수정하지 않는다.",
        "- Projections and Documents는 Canonical Context read model과 permitted Derived "
        "State만 읽는다.",
    )
    replace_once(
        architecture,
        "2. Named Candidate Inspection projection에만 필요한, domain과 privacy policy가 허용한\n"
        "   bounded Session Candidate metadata.",
        "2. Session Candidate input authority is absent.",
    )
    replace_once(
        architecture,
        "| `purpose` | Candidate Inspection only |",
        "| `purpose` | Candidate Inspection authority absent |",
    )
    replace_once(
        architecture,
        "| `input_information_class` | Session Candidate remains Session Candidate and is not "
        "reclassified as Derived State. |",
        "| `input_information_class` | No Candidate input class. |",
    )
    replace_once(
        architecture,
        "| `allowed_read` | `domain-model.md`가 소유하는 user-inspectable Candidate metadata와, "
        "적용되는 collection, retention, deletion 및 privacy policy가 명시적으로 허용한 "
        "bounded Candidate content만 읽는다. |",
        "| `allowed_read` | No Candidate read. |",
    )
    replace_once(
        architecture,
        "Candidate Inspection에만 domain/privacy-policy-authorized bounded Session Candidate "
        "metadata, ",
        "",
    )


def self_test() -> int:
    maintained_errors = check_repository(REPOSITORY_ROOT)
    if maintained_errors:
        raise AssertionError("maintained repository did not pass before self-test: " + maintained_errors[0])

    tracked = tracked_paths(REPOSITORY_ROOT)
    with tempfile.TemporaryDirectory(prefix="volicord-architecture-contracts-") as temporary:
        temporary_root = Path(temporary)
        base = temporary_root / "positive"
        fixture_tracked = copy_self_test_fixture(base, tracked)
        positive_errors = check_repository(base, fixture_tracked)
        if positive_errors:
            raise AssertionError("positive fixture failed: " + positive_errors[0])

        cases: tuple[tuple[str, Callable[[Path, list[str]], None], str], ...] = (
            (
                "missing-heading",
                lambda root, _: replace_once(
                    root / DESIGN_DIRECTORY / "portable-context.md",
