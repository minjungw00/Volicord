                lambda root, _: replace_once(
                    root / DESIGN_DIRECTORY / "architecture.md",
                    "| `allowed_read` | `domain-model.md`가 소유하는 user-inspectable Candidate metadata와, "
                    "적용되는 collection, retention, deletion 및 privacy policy가 명시적으로 허용한 "
                    "bounded Candidate content만 읽는다. |",
                    "| `allowed_read` | Candidate content may be read. |",
                ),
                "missing bounded domain/privacy Candidate read scope",
            ),
            (
                "missing-candidate-inspection-no-mutation",
                lambda root, _: replace_once(
                    root / DESIGN_DIRECTORY / "architecture.md",
                    "| `mutation_boundary` | Read, omission, ranking, rendering, expansion 또는 inspection "
                    "failure는 Candidate를 promote, dismiss, expire, delete, correct, reinterpret하거나 "
                    "retention/opt-out state를 바꿀 수 없다. |",
                    "| `mutation_boundary` | Mutation behavior removed. |",
                ),
                "missing Candidate Inspection no-mutation behavior",
            ),
            (
                "unrestricted-candidate-body-projection",
                lambda root, _: replace_once(
                    root / DESIGN_DIRECTORY / "projections-and-documents.md",
                    "밖의 content를 읽는 blanket authority가 아니다.",
                    "밖의 content를 읽는 blanket authority가 아니다. Unrestricted Candidate-body "
                    "access is allowed.",
                ),
                "claims unrestricted Candidate-body access",
            ),
            (
                "specialized-candidate-without-top-level-authority",
                remove_top_level_candidate_read_authority,
                "Candidate Inspection exceeds top-level architecture authority",
            ),
            (
                "missing-guarded-expiration",
                lambda root, _: replace_once(
                    root / DESIGN_DIRECTORY / "architecture.md",
                    "| `expiration` |",
                    "| `removed_expiration` |",
                ),
                "missing Guarded confirmation field: expiration",
            ),
            (
                "missing-guarded-user-source",
                lambda root, _: replace_once(
                    root / DESIGN_DIRECTORY / "architecture.md",
                    "`Source`-linked response",
                    "unlinked response",
                ),
                "missing Guarded user-response Source linkage",
            ),
            (
                "missing-confirmation-reuse-rejection",
                lambda root, _: replace_once(
                    root / DESIGN_DIRECTORY / "architecture.md",
                    "consumed confirmation의 reuse는 reject한다",
                    "consumed confirmation reuse marker removed",
                ),
                "missing confirmation reuse rejection",
            ),
            (
                "missing-no-dispatch-rule",
                lambda root, _: replace_once(
                    root / DESIGN_DIRECTORY / "failure-and-recovery.md",
                    "Guarded effect는 valid exact-match confirmation의 pre-dispatch validation보다 먼저\n"
                    "   dispatch되지 않는다.",
                    "Guarded effect may dispatch before confirmation validation.",
                ),
                "missing no-dispatch-before-confirmation rule",
            ),
        )

        for name, mutate, expected_error in cases:
            case_root = temporary_root / name
            shutil.copytree(base, case_root)
            case_tracked = list(fixture_tracked)
            mutate(case_root, case_tracked)
            errors = check_repository(case_root, case_tracked)
            if not any(expected_error in error for error in errors):
                raise AssertionError(
                    f"negative case {name} did not report {expected_error!r}; got: {errors}"
                )

    case_names = ", ".join(name for name, _, _ in cases)
    print(
        f"architecture contract self-test passed: positive fixture and {len(cases)} negative cases; "
        f"cases: {case_names}"
    )
    return 0


def report(errors: list[str]) -> int:
    if errors:
        for error in errors:
            print(f"architecture contract error: {error}", file=sys.stderr)
        return 1
    print(f"architecture contracts passed: {len(ARCHITECTURE_DOCUMENTS)} active owner documents")
    return 0


def usage() -> int:
    print(
        "usage:\n"
        "  rebuild/scripts/check-architecture-contracts\n"
        "  rebuild/scripts/check-architecture-contracts --self-test",
        file=sys.stderr,
    )
    return 2


def main(arguments: list[str]) -> int:
    if not arguments:
        try:
            return report(check_repository(REPOSITORY_ROOT))
        except (OSError, RuntimeError) as error:
            print(f"architecture contract check failed: {error}", file=sys.stderr)
            return 1
    if arguments == ["--self-test"]:
        try:
            return self_test()
        except (AssertionError, OSError, RuntimeError) as error:
            print(f"architecture contract self-test failed: {error}", file=sys.stderr)
            return 1
    return usage()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
