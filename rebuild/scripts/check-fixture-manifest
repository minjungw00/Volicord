#!/usr/bin/env python3
"""Validate maintained validation fixture metadata and content hashes."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import sys


REPOSITORY_ROOT = Path(__file__).resolve().parents[2]
REQUIRED_FIELDS = {
    "id",
    "validation_id",
    "path",
    "purpose",
    "expected_entities",
    "expected_relations",
    "expected_unsupported",
    "content_sha256",
    "origin",
    "license",
}


def fixture_hash(directory: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(item for item in directory.rglob("*") if item.is_file()):
        relative = path.relative_to(directory).as_posix().encode("utf-8")
        content = path.read_bytes()
        digest.update(len(relative).to_bytes(8, "big"))
        digest.update(relative)
        digest.update(len(content).to_bytes(8, "big"))
        digest.update(content)
    return digest.hexdigest()


def main(arguments: list[str]) -> int:
    if len(arguments) != 1:
        print("usage: rebuild/scripts/check-fixture-manifest <manifest.json>", file=sys.stderr)
        return 2
    manifest_path = Path(arguments[0])
    data = json.loads(manifest_path.read_text(encoding="utf-8"))
    errors: list[str] = []
    if data.get("schema_version") != 1:
        errors.append("schema_version must be 1")
    fixtures = data.get("fixtures")
    if not isinstance(fixtures, list):
        errors.append("fixtures must be a list")
        fixtures = []
    identifiers: set[str] = set()
    for index, fixture in enumerate(fixtures):
        if not isinstance(fixture, dict):
            errors.append(f"fixture {index} must be an object")
            continue
        missing = REQUIRED_FIELDS - fixture.keys()
        if missing:
            errors.append(f"fixture {index} missing fields: {', '.join(sorted(missing))}")
            continue
        identifier = fixture["id"]
        if identifier in identifiers:
            errors.append(f"duplicate fixture id: {identifier}")
        identifiers.add(identifier)
        directory = REPOSITORY_ROOT / fixture["path"]
        if not directory.is_dir():
            errors.append(f"fixture directory does not exist: {fixture['path']}")
            continue
        actual_hash = fixture_hash(directory)
        if fixture["content_sha256"] != actual_hash:
            errors.append(
                f"fixture hash mismatch for {identifier}: expected {fixture['content_sha256']}, got {actual_hash}"
            )
        for field in ("purpose", "origin", "license"):
            if not isinstance(fixture[field], str) or not fixture[field].strip():
                errors.append(f"{identifier}.{field} must be a non-empty string")
        for field in ("expected_entities", "expected_relations", "expected_unsupported"):
            if not isinstance(fixture[field], list):
                errors.append(f"{identifier}.{field} must be a list")
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1
    print(f"fixture manifest passed: {len(fixtures)} fixture(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
