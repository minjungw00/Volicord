}
PORTABLE_PATH_PREFIXES = (
    "./",
    "<gate-artifact>",
    "<local-validation-artifact>",
    "<official-v11:",
)
PROJECTED_ROLES = {
    "executable_path",
    "gate_path",
    "local_validation_path",
    "official_v11_path",
    "repository_path",
}
LEGACY_EXECUTION_ARGV_KEYS = {
    "argument_classifications",
    "argv_completeness",
    "argv_projection_policy",
    "raw_argv_retained_locally",
    "sanitization_applied",
    "sanitized_argument_count",
    "sanitizations",
}


def fail(message: str) -> None:
    raise ValueError(message)


def load_json(contents: dict[str, bytes], name: str) -> Any:
    try:
        return json.loads(contents[name])
    except KeyError:
        fail(f"missing archive member: {name}")
    except json.JSONDecodeError as error:
        fail(f"invalid JSON in {name}: {error.msg}")


def verify_negative_retention_attestation(value: Any, location: str) -> None:
    if (
        not isinstance(value, dict)
        or set(value) != NEGATIVE_RETENTION_ATTESTATION_FIELDS
        or any(value.get(field) is not False for field in NEGATIVE_RETENTION_ATTESTATION_FIELDS)
    ):
        fail(f"invalid negative-retention attestation in {location}")


def inspect_keys(value: Any, location: str, path: tuple[str | int, ...] = ()) -> None:
    if isinstance(value, dict):
        for key, child in value.items():
            normalized_key = str(key).lower()
            child_path = (*path, normalized_key)
            if (
                location == "capsule.json"
                and child_path == NEGATIVE_RETENTION_ATTESTATION_PATH
            ):
                verify_negative_retention_attestation(child, location)
                continue
            if normalized_key in PROHIBITED_KEYS:
                fail(f"prohibited content key in {location}: {key}")
            inspect_keys(child, location, child_path)
    elif isinstance(value, list):
        for index, child in enumerate(value):
            inspect_keys(child, location, (*path, index))


def verify_argv_policy(value: Any, location: str) -> None:
    expected = {
        "kind": "sanitized_argv_policy",
        "completeness": "sanitized_portable_projection",
        "projection": "explicit_semantic_argument_roles",
        "raw_argv": "ignored_local_execution_evidence",
        "structural_arguments": {
            "classification": "structural",
            "role": "approved_structural_token",
            "encoding": "omitted_from_non_structural_argument_roles",
        },
        "non_structural_argument_roles": {
            "encoding": "argument_index_classification_semantic_role",
            "classifications": ["projected", "redacted"],
        },
    }
    if value != expected:
        fail(f"invalid portable argv policy in {location}")


def argument_matches(
    argv: list[str],
    roles_by_index: dict[int, tuple[str, str]],
    index: int,
    expected: object,
) -> bool:
    argument = argv[index]
    role = roles_by_index.get(index)
    if expected == ("executable",):
        return argument in PORTABLE_EXECUTABLES and role in {
            None,
            ("projected", "executable_path"),
        }
    if expected == ("path",):
        return (
            role is not None
            and (
                (role[0] == "projected" and role[1] in PROJECTED_ROLES - {"executable_path"})
                or (
                    role[0] == "redacted"
                    and role[1]
                    in {
                        "escaping_relative_path",
                        "external_absolute_path",
                        "unrecognized_relative_path",
                    }
                )
            )
        )
    if isinstance(expected, tuple) and len(expected) == 2 and expected[0] == "redacted":
        return role == expected and argument == f"<redacted:{expected[1].replace('_', '-')}>"
    return isinstance(expected, str) and role is None and argument == expected


def argv_matches(
    argv: list[str],
    roles_by_index: dict[int, tuple[str, str]],
    expected: tuple[object, ...] | list[object],
) -> bool:
    return len(argv) == len(expected) and all(
        argument_matches(argv, roles_by_index, index, item)
        for index, item in enumerate(expected)
    )


def verify_git_argv(
    argv: list[str], roles_by_index: dict[int, tuple[str, str]]
) -> bool:
    expected: list[object] = [("executable",)]
    index = 1
    while index + 1 < len(argv) and argv[index] == "-c":
        expected.extend(("-c", ("redacted", "config_payload")))
        index += 2
    if index >= len(argv):
        return False
    suffixes: dict[str, tuple[object, ...]] = {
        "add": (("path",),),
        "clone": ("--quiet", "--no-hardlinks", ("path",), ("path",)),
        "commit": ("--quiet", "-m", ("redacted", "message_payload")),
        "init": (),
        "rev-parse": ("HEAD",),
    }
    subcommand = argv[index]
    suffix = suffixes.get(subcommand)
    if suffix is None:
        return False
    expected.append(subcommand)
    if subcommand == "init" and argv[index + 1 :] == ["--quiet"]:
        expected.append("--quiet")
    else:
        expected.extend(suffix)
    return argv_matches(argv, roles_by_index, expected)


def verify_volicord_argv(
    argv: list[str], roles_by_index: dict[int, tuple[str, str]]
) -> bool:
    expected_prefix: list[object] = [("executable",)]
    offset = 1
    while offset < len(argv):
        if argv[offset] == "--json":
            expected_prefix.append("--json")
            offset += 1
        elif argv[offset] in {"--runtime", "--repository"} and offset + 1 < len(argv):
            expected_prefix.extend((argv[offset], ("path",)))
            offset += 2
        elif argv[offset] == "--project" and offset + 1 < len(argv):
            expected_prefix.extend(("--project", ("redacted", "project_identity")))
            offset += 2
        elif (
            argv[offset] == "--locale"
            and offset + 1 < len(argv)
            and argv[offset + 1] in {"en", "ko"}
        ):
            expected_prefix.extend(("--locale", argv[offset + 1]))
            offset += 2
        else:
            break
    return any(
        argv_matches(argv, roles_by_index, [*expected_prefix, *shape])
        for shape in VOLICORD_SHAPES
    )


def verify_current_command_grammar(
    argv: list[str],
    roles_by_index: dict[int, tuple[str, str]],
    location: str,
) -> None:
    unknown_executable = ("redacted", "unknown_executable")
    if roles_by_index.get(0) == unknown_executable:
        if argv[0] != "<redacted:unknown-executable>" or any(
            roles_by_index.get(index) != ("redacted", "unknown_operand")
            for index in range(1, len(argv))
        ):
            fail(f"portable unknown command is not conservatively redacted in {location}")
        return

    executable = argv[0]
    if executable not in PORTABLE_EXECUTABLES or roles_by_index.get(0) not in {
        None,
        ("projected", "executable_path"),
    }:
        fail(f"portable argv executable is not approved in {location}")

    matched = False
    if executable in {"python", "python3", "bash", "sh", "zsh"}:
        if len(argv) >= 3 and argv[1] in {"-c", "-m"}:
            expected = [
                ("executable",),
                argv[1],
                ("redacted", "inline_program" if argv[1] == "-c" else "module_operand"),
                *[("redacted", "program_argument") for _ in argv[3:]],
            ]
            matched = argv_matches(argv, roles_by_index, expected)
    elif executable == "codex":
        matched = argv_matches(
            argv,
            roles_by_index,
            (
                ("executable",),
                "--dangerously-bypass-hook-trust",
                "--ask-for-approval",
                "never",
                "--config",
                ("redacted", "config_payload"),
                "exec",
                "--ephemeral",
                "--json",
                "--sandbox",
                "read-only",
                "--skip-git-repo-check",
                "-C",
                ("path",),
                ("redacted", "private_prompt"),
            ),
        )
    elif executable == "cargo":
        matched = any(
            argv_matches(
                argv,
                roles_by_index,
                (("executable",), *[("path",) if item is None else item for item in shape]),
            )
            for shape in CARGO_SHAPES
        )
    elif executable == "git":
        matched = verify_git_argv(argv, roles_by_index)
    elif executable == "volicord":
        matched = verify_volicord_argv(argv, roles_by_index)
    elif executable == "harness.py":
        shapes = (
            (("executable",), "self-check"),
            (("executable",), "self-test"),
            (("executable",), "credential-audit", "--artifact-dir", ("path",)),
            (
                ("executable",), "preflight", "--validated-head",
                ("redacted", "candidate_identity"), "--final-artifact", ("path",),
            ),
            (
                ("executable",), "run", "--validated-head",
                ("redacted", "candidate_identity"), "--final-artifact", ("path",),
                "--output-dir", ("path",),
            ),
            (
                ("executable",), "--live", "--authorize-source-transmission",
                "openai-codex-background-semantic-bounded-rust-v1", "--model",
                ("redacted", "provider_model"), "--evidence-output", ("path",),
            ),
        )
        matched = any(argv_matches(argv, roles_by_index, shape) for shape in shapes)
    elif executable == "verify-validation-archive":
        matched = argv_matches(
            argv,
            roles_by_index,
            (
                ("executable",), ("path",), "--expected-candidate",
                ("redacted", "candidate_identity"),
            ),
        )
    elif executable == "check-fixture-manifest":
        matched = argv_matches(argv, roles_by_index, (("executable",), ("path",)))
    elif executable == "check-architecture-contracts":
        matched = any(
            argv_matches(argv, roles_by_index, shape)
            for shape in (
                (("executable",),),
                (("executable",), "--self-test"),
            )
        )
    elif executable in {"assertions.py", "campaign_self_test.py"}:
        matched = argv_matches(argv, roles_by_index, (("executable",),))
    elif executable == "install.sh":
        matched = argv_matches(
            argv,
            roles_by_index,
            (("executable",), "--prefix", ("path",), "--runtime-dir", ("path",)),
        )
    elif executable == "validate":
        matched = len(argv) == 2 and argv[1] in {
            "evidence-archive-self-test",
            "gate-entrypoint-self-test",
            "gate-self-test",
            "self-test",
        } and argv_matches(argv, roles_by_index, (("executable",), argv[1]))

    if matched:
        return
    if all(
        roles_by_index.get(index) == ("redacted", "unknown_operand")
        for index in range(1, len(argv))
    ):
        return
    fail(f"portable argv violates the current {executable} command-family grammar in {location}")


def verify_portable_execution(value: Any, location: str) -> None:
    if not isinstance(value, dict):
        fail(f"invalid portable execution in {location}")
    if LEGACY_EXECUTION_ARGV_KEYS & set(value):
        fail(f"portable execution uses non-current argv metadata in {location}")
    argv = value.get("argv")
    if not isinstance(argv, list) or not argv or not all(isinstance(item, str) for item in argv):
        fail(f"portable execution argv is invalid in {location}")
    role_entries = value.get("non_structural_argument_roles")
    if not isinstance(role_entries, list):
        fail(f"portable argv role records are invalid in {location}")
    roles_by_index: dict[int, tuple[str, str]] = {}
    for entry in role_entries:
        if (
            not isinstance(entry, list)
            or len(entry) != 3
            or not isinstance(entry[0], int)
            or entry[0] < 0
            or entry[0] >= len(argv)
            or entry[0] in roles_by_index
            or entry[1] not in PORTABLE_ROLE_CLASSIFICATIONS
            or entry[2] not in PORTABLE_ROLES
        ):
            fail(f"portable argv role record is invalid in {location}")
        roles_by_index[entry[0]] = (entry[1], entry[2])
    for index in range(len(argv)):
        classification, role = roles_by_index.get(
            index, ("structural", "approved_structural_token")
        )
        argument = argv[index]
        if classification == "structural":
            if argument.startswith("<redacted:"):
                fail(f"portable argv marks a redaction as structural in {location}")
        elif classification == "redacted":
            if role in PROJECTED_ROLES:
                fail(f"portable argv redaction uses a projected role in {location}")
            expected_marker = f"<redacted:{str(role).replace('_', '-')}>"
            if argument != expected_marker:
                fail(f"portable argv redaction marker is invalid in {location}")
        elif role not in PROJECTED_ROLES:
            fail(f"portable argv projection uses a non-path role in {location}")
        elif role == "executable_path":
            if argument not in PORTABLE_EXECUTABLES:
                fail(f"portable projected executable is unapproved in {location}")
        elif argument != "." and not argument.startswith(PORTABLE_PATH_PREFIXES):
            fail(f"portable projected path is invalid in {location}")
    executable = argv[0]
    if executable == "codex" and "exec" in argv and not argv[-1].startswith("<redacted:"):
        fail(f"portable Codex execution retains a prompt-bearing argument in {location}")
    if executable.startswith("python") and "-c" in argv:
        code_index = argv.index("-c") + 1
        if code_index >= len(argv) or not argv[code_index].startswith("<redacted:"):
            fail(f"portable Python execution retains an inline program in {location}")
    verify_current_command_grammar(argv, roles_by_index, location)


def verify_process_payloads(contents: dict[str, bytes]) -> None:
    processes = load_json(contents, f"{ROOT}/processes.json")
    if processes.get("kind") != "sanitized_gate_processes" or not isinstance(
        processes.get("processes"), list
    ):
        fail("invalid sanitized process evidence")
    verify_argv_policy(processes.get("argv_policy"), "processes.json")
    for index, process in enumerate(processes["processes"]):
        verify_portable_execution(process, f"processes.json.processes[{index}]")
    final_name = f"{ROOT}/final-summary.json"
    if final_name in contents:
        final = load_json(contents, final_name)
        if final.get("kind") != "sanitized_exact_final_summary" or not isinstance(
            final.get("commands"), list
        ):
            fail("invalid sanitized final summary")
        verify_argv_policy(final.get("argv_policy"), "final-summary.json")
        for index, command in enumerate(final["commands"]):
            verify_portable_execution(command, f"final-summary.json.commands[{index}]")


def verify(path: Path, expected_candidate: str | None) -> dict[str, Any]:
    if path.stat().st_size > MAX_ARCHIVE_BYTES:
        fail("archive exceeds the bounded size")
    contents: dict[str, bytes] = {}
    observed_modes: dict[str, tuple[str, str]] = {}
    with tarfile.open(path, "r:*") as archive:
        for member in archive.getmembers():
            pure = PurePosixPath(member.name)
            if pure.is_absolute() or ".." in pure.parts or not pure.parts or pure.parts[0] != ROOT:
                fail(f"unsafe archive member path: {member.name}")
            if member.name in observed_modes:
                fail(f"duplicate archive member: {member.name}")
            if member.isdir():
                observed_modes[member.name] = ("directory", f"{member.mode & 0o7777:04o}")
                continue
            if not member.isfile():
                fail(f"unsupported archive member type: {member.name}")
            if member.size > MAX_MEMBER_BYTES:
                fail(f"archive member exceeds its bound: {member.name}")
            extracted = archive.extractfile(member)
            if extracted is None:
                fail(f"could not read archive member: {member.name}")
            value = extracted.read(MAX_MEMBER_BYTES + 1)
            if len(value) != member.size:
                fail(f"archive member size mismatch: {member.name}")
            contents[member.name] = value
            observed_modes[member.name] = ("file", f"{member.mode & 0o7777:04o}")

    manifest_name = f"{ROOT}/archive-manifest.json"
    modes_name = f"{ROOT}/file-modes.json"
    manifest = load_json(contents, manifest_name)
    modes = load_json(contents, modes_name)
    if manifest.get("kind") != "validation_evidence_archive_manifest":
        fail("invalid archive manifest kind")
    if manifest.get("member_size_limit_bytes") != MAX_MEMBER_BYTES:
        fail("archive manifest member-size contract is invalid")
    candidate = manifest.get("candidate_head")
    if not isinstance(candidate, str) or re.fullmatch(r"[0-9a-f]{40}", candidate) is None:
        fail("archive manifest candidate is invalid")
    if expected_candidate is not None and candidate != expected_candidate:
        fail("archive candidate does not match the expected candidate")

    expected_modes: dict[str, tuple[str, str]] = {}
    if modes.get("kind") != "archive_file_modes" or not isinstance(modes.get("entries"), list):
        fail("invalid file-mode manifest")
    for entry in modes["entries"]:
        if not isinstance(entry, dict):
            fail("invalid file-mode manifest entry")
        item = (entry.get("type"), entry.get("mode"))
        name = entry.get("path")
        if not isinstance(name, str) or name in expected_modes:
            fail("invalid or duplicate file-mode manifest path")
        expected_modes[name] = item
    if observed_modes != expected_modes:
        fail("archive members or POSIX modes do not match the file-mode manifest")

    files = manifest.get("files")
    if not isinstance(files, dict):
        fail("archive manifest file identities are invalid")
    names = set(files)
    if not REQUIRED_PAYLOADS <= names or not names <= REQUIRED_PAYLOADS | OPTIONAL_PAYLOADS:
        fail("archive payload names do not match the bounded evidence contract")
    expected_files = {manifest_name, *[f"{ROOT}/{name}" for name in files]}
    if set(contents) != expected_files:
        fail("archive payload is incomplete or has unlisted files")
    for name, identity in files.items():
        member_name = f"{ROOT}/{name}"
        body = contents[member_name]
        if (
            not isinstance(identity, dict)
            or identity.get("size_bytes") != len(body)
            or identity.get("mode") != "0644"
            or identity.get("sha256") != hashlib.sha256(body).hexdigest()
        ):
            fail(f"archive payload identity mismatch: {name}")
        for pattern in SECRET_PATTERNS:
            if pattern.search(body):
                fail(f"credential-like prohibited content in {name}")
        if ABSOLUTE_HOST_PATH.search(body):
            fail(f"absolute host path is prohibited in {name}")
        inspect_keys(load_json(contents, member_name), name)

    verify_process_payloads(contents)

    capsule = load_json(contents, f"{ROOT}/capsule.json")
    admission = load_json(contents, f"{ROOT}/admission.json")
    gate_result = load_json(contents, f"{ROOT}/gate-result.json")
    tracked = load_json(contents, f"{ROOT}/tracked-files.json")
    candidates = {
        capsule.get("validated_candidate_head"),
        admission.get("candidate_head"),
        gate_result.get("candidate_head"),
        tracked.get("candidate_head"),
    }
    if candidates != {candidate}:
        fail("candidate identities disagree inside the archive")
    evidence = capsule.get("evidence_archive")
    if (
        capsule.get("phase_8_ready") is not False
        or not isinstance(evidence, dict)
        or evidence.get("status") != "pending"
        or gate_result.get("status") != "blocked"
        or gate_result.get("evidence_archive_status") != "pending"
    ):
        fail("archive does not contain a truthful pre-verification gate snapshot")
    capsule_bytes = contents[f"{ROOT}/capsule.json"]
    if manifest.get("capsule_sha256") != hashlib.sha256(capsule_bytes).hexdigest():
        fail("capsule hash does not match the archive manifest")
    if manifest.get("source_final_summary_sha256") != capsule.get("final_summary_sha256"):
        fail("source final-summary hash does not match the capsule")
    final_was_run = capsule.get("final_summary_sha256") is not None
    if final_was_run != ("final-summary.json" in names):
        fail("sanitized final-summary presence disagrees with the capsule")

    tracked_files = tracked.get("files")
    if tracked.get("kind") != "candidate_tracked_file_modes" or not isinstance(tracked_files, list):
        fail("invalid tracked-file mode evidence")
    for entry in tracked_files:
        mode = entry.get("git_mode") if isinstance(entry, dict) else None
        if (
            entry.get("tracked") is not True
            or mode not in {"100644", "100755"}
            or entry.get("executable") != (mode == "100755")
            or re.fullmatch(r"[0-9a-f]{40}", str(entry.get("git_object_id"))) is None
            or not SHA256.fullmatch(str(entry.get("sha256")))
        ):
            fail("invalid tracked/executable file-mode evidence")

    return {
        "kind": "validation_evidence_archive_verification",
        "status": "passed",
        "candidate_head": candidate,
        "archive_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        "archive_size_bytes": path.stat().st_size,
        "member_count": len(observed_modes),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("archive", type=Path)
    parser.add_argument("--expected-candidate")
    arguments = parser.parse_args()
    try:
        result = verify(arguments.archive, arguments.expected_candidate)
    except (OSError, tarfile.TarError, ValueError) as error:
        print(f"validation evidence archive verification failed: {error}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
