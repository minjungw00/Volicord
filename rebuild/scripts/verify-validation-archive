    "full_command_log",
}
NEGATIVE_RETENTION_ATTESTATION_PATH = (
    "live_provider_qualification",
    "evidence",
    "retained_evidence",
)
NEGATIVE_RETENTION_ATTESTATION_FIELDS = {
    "source_body",
    "provider_response_body",
    "credential",
}
