#!/usr/bin/env python3
"""Independently verify one sanitized validation evidence archive."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path, PurePosixPath
import re
import sys
import tarfile
from typing import Any


ROOT = "validation-evidence"
MAX_ARCHIVE_BYTES = 512 * 1024
MAX_MEMBER_BYTES = 256 * 1024
SHA256 = re.compile(r"[0-9a-f]{64}")
SECRET_PATTERNS = (
    re.compile(rb"sk-[A-Za-z0-9_-]{16,}"),
    re.compile(rb"Bearer[ \t]+[A-Za-z0-9._~+/=-]{12,}", re.IGNORECASE),
    re.compile(rb"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
)
ABSOLUTE_HOST_PATH = re.compile(rb'(?<![A-Za-z0-9_.-])/(?:home|Users|private|tmp|var/tmp)/[^\s"\\]+')
PROHIBITED_KEYS = {
    "api_key",
    "access_token",
    "refresh_token",
    "id_token",
    "authorization_header",
    "credential_value",
    "credential_fingerprint",
    "auth_json_contents",
    "environment_variables",
    "environment_dump",
    "credential",
    "provider_response_body",
    "source_body",
    "raw_repository_source_body",
    "raw_prompt",
    "private_prompt",
    "prompt_body",
    "raw_provider_payload",
    "full_command_log",
}
NEGATIVE_RETENTION_ATTESTATION_PATH = (
    "live_provider_qualification",
    "evidence",
    "retained_evidence",
)
NEGATIVE_RETENTION_ATTESTATION_FIELDS = {
    "source_body",
    "provider_response_body",
    "credential",
}
REQUIRED_PAYLOADS = {
    "admission.json",
    "capsule.json",
    "file-modes.json",
    "gate-result.json",
    "processes.json",
    "tracked-files.json",
}
OPTIONAL_PAYLOADS = {"final-summary.json"}
PORTABLE_STRUCTURAL_ARGUMENTS = {
