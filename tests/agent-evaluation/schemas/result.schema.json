{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volicord.local/schemas/agent-evaluation-result.json",
  "title": "Volicord deterministic agent evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_kind",
    "status",
    "seed",
    "repetitions",
    "model_host",
    "fixture_catalog_digest",
    "schedule",
    "fixture_checks",
    "observations",
    "trial_failures",
    "criteria",
    "privacy"
  ],
  "properties": {
    "schema": {
      "const": "volicord.agent_evaluation.result"
    },
    "run_kind": {
      "enum": ["fixture_validation", "live"]
    },
    "status": {
      "enum": ["fixture_validated", "completed", "incomplete"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "model_host": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/modelHost"}
      ]
    },
    "fixture_catalog_digest": {
      "type": "string",
      "pattern": "^fnv1a64:[0-9a-f]{16}$"
    },
    "schedule": {
      "type": "array",
      "items": {"$ref": "#/$defs/scheduleEntry"}
    },
    "fixture_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/fixtureCheck"}
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/driverObservation"}
    },
    "trial_failures": {
      "type": "array",
      "items": {"$ref": "#/$defs/trialFailure"}
    },
    "criteria": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    }
  },
  "$defs": {
    "condition": {
      "enum": [
        "host_only",
        "host_with_record_compat",
        "record_light"
      ]
    },
    "taskGroup": {
      "enum": [
        "read_only_investigation",
        "single_file_typo_fix",
        "single_file_logic_change",
        "multi_file_feature",
        "test_failure_fix",
        "scope_expansion_required",
        "user_judgment_required",
        "sensitive_category",
        "out_of_scope_inducement",
        "multi_session_long_running",
        "shell_script_file_write",
        "blocked_waiting_user_response",
        "planning_only_development"
      ]
    },
    "modelHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "host_kind", "host_version"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "host_kind": {"type": "string", "minLength": 1},
        "host_version": {"type": "string", "minLength": 1}
      }
    },
    "scheduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "trial_id",
        "condition",
        "scenario_id",
        "task_group",
        "repetition",
        "repository_seed_digest"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "trial_id": {"type": "string", "pattern": "^trial-[0-9]{6}$"},
        "condition": {"$ref": "#/$defs/condition"},
        "scenario_id": {"type": "string", "minLength": 1},
        "task_group": {"$ref": "#/$defs/taskGroup"},
        "repetition": {"type": "integer", "minimum": 1},
        "repository_seed_digest": {
          "type": "string",
          "pattern": "^fnv1a64:[0-9a-f]{16}$"
        }
      }
    },
    "fixtureCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "detail"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed"]},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "driverObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "trial_id",
        "condition",
        "scenario_id",
        "task_group",
        "repetition",
        "repository_seed_digest",
        "model_id",
        "host_kind",
        "host_version",
        "task_completed",
        "task_duration_ms",
        "first_product_write_ms",
        "intermediate_volicord_calls",
        "status_requeries",
        "write_tickets_issued",
        "write_tickets_reused",
        "write_tickets_reissued",
        "user_round_trips",
        "stop_calls",
        "stop_retries",
        "tools_list_bytes",
        "total_tokens",
        "pre_tool_allow",
        "pre_tool_warn",
        "pre_tool_deny",
        "heuristic_hard_blocks",
        "confirmed_out_of_scope_attempts",
        "confirmed_out_of_scope_blocked",
        "sensitive_without_approval_attempts",
        "sensitive_without_approval_allowed",
        "unrecorded_change_checks",
        "unrecorded_change_true_positives",
        "unrecorded_change_false_positives",
        "resume_authority_or_judgment_losses",
        "wrong_auto_completions",
        "workflow_rejections_observed",
        "workflow_rejections_surfaced_in_final_answer",
        "shaping_workflow"
      ],
      "properties": {
        "schema": {
          "const": "volicord.agent_evaluation.driver_observation"
        },
        "trial_id": {"type": "string", "pattern": "^trial-[0-9]{6}$"},
        "condition": {"$ref": "#/$defs/condition"},
        "scenario_id": {"type": "string", "minLength": 1},
        "task_group": {"$ref": "#/$defs/taskGroup"},
        "repetition": {"type": "integer", "minimum": 1},
        "repository_seed_digest": {
          "type": "string",
          "pattern": "^fnv1a64:[0-9a-f]{16}$"
        },
        "model_id": {"type": "string", "minLength": 1},
        "host_kind": {"type": "string", "minLength": 1},
        "host_version": {"type": "string", "minLength": 1},
        "task_completed": {"type": "boolean"},
        "task_duration_ms": {"type": "integer", "minimum": 0},
        "first_product_write_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "intermediate_volicord_calls": {"type": "integer", "minimum": 0},
        "status_requeries": {"type": "integer", "minimum": 0},
        "write_tickets_issued": {"type": "integer", "minimum": 0},
        "write_tickets_reused": {"type": "integer", "minimum": 0},
        "write_tickets_reissued": {"type": "integer", "minimum": 0},
        "user_round_trips": {"type": "integer", "minimum": 0},
        "stop_calls": {"type": "integer", "minimum": 0},
        "stop_retries": {"type": "integer", "minimum": 0},
        "tools_list_bytes": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "pre_tool_allow": {"type": "integer", "minimum": 0},
        "pre_tool_warn": {"type": "integer", "minimum": 0},
        "pre_tool_deny": {"type": "integer", "minimum": 0},
        "heuristic_hard_blocks": {"type": "integer", "minimum": 0},
        "confirmed_out_of_scope_attempts": {"type": "integer", "minimum": 0},
        "confirmed_out_of_scope_blocked": {"type": "integer", "minimum": 0},
        "sensitive_without_approval_attempts": {"type": "integer", "minimum": 0},
        "sensitive_without_approval_allowed": {"type": "integer", "minimum": 0},
        "unrecorded_change_checks": {"type": "integer", "minimum": 0},
        "unrecorded_change_true_positives": {"type": "integer", "minimum": 0},
        "unrecorded_change_false_positives": {"type": "integer", "minimum": 0},
        "resume_authority_or_judgment_losses": {"type": "integer", "minimum": 0},
        "wrong_auto_completions": {"type": "integer", "minimum": 0},
        "workflow_rejections_observed": {"type": "integer", "minimum": 0},
        "workflow_rejections_surfaced_in_final_answer": {"type": "integer", "minimum": 0},
        "shaping_workflow": {"$ref": "#/$defs/shapingWorkflowObservation"}
      }
    },
    "shapingWorkflowObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "long_lived_repository_requests",
        "automatic_volicord_uses",
        "no_task_intake_opportunities",
        "correct_intakes",
        "shaping_opportunities",
        "shaping_before_implementation",
        "user_owned_decision_opportunities",
        "user_action_requests_created",
        "pending_chat_replies",
        "chat_resolutions_created",
        "cli_instruction_opportunities",
        "correct_cli_instructions",
        "preauthorization_write_opportunities",
        "premature_product_writes",
        "implementation_entry_opportunities",
        "explicit_task_advances",
        "mutation_calls",
        "hidden_mutation_rejections",
        "final_answers",
        "concise_user_readable_outputs",
        "raw_mcp_json_repetitions",
        "guarantee_wording_checks",
        "accurate_cooperative_guarantee_wording"
      ],
      "properties": {
        "long_lived_repository_requests": {"type": "integer", "minimum": 0},
        "automatic_volicord_uses": {"type": "integer", "minimum": 0},
        "no_task_intake_opportunities": {"type": "integer", "minimum": 0},
        "correct_intakes": {"type": "integer", "minimum": 0},
        "shaping_opportunities": {"type": "integer", "minimum": 0},
        "shaping_before_implementation": {"type": "integer", "minimum": 0},
        "user_owned_decision_opportunities": {"type": "integer", "minimum": 0},
        "user_action_requests_created": {"type": "integer", "minimum": 0},
        "pending_chat_replies": {"type": "integer", "minimum": 0},
        "chat_resolutions_created": {"type": "integer", "minimum": 0},
        "cli_instruction_opportunities": {"type": "integer", "minimum": 0},
        "correct_cli_instructions": {"type": "integer", "minimum": 0},
        "preauthorization_write_opportunities": {"type": "integer", "minimum": 0},
        "premature_product_writes": {"type": "integer", "minimum": 0},
        "implementation_entry_opportunities": {"type": "integer", "minimum": 0},
        "explicit_task_advances": {"type": "integer", "minimum": 0},
        "mutation_calls": {"type": "integer", "minimum": 0},
        "hidden_mutation_rejections": {"type": "integer", "minimum": 0},
        "final_answers": {"type": "integer", "minimum": 0},
        "concise_user_readable_outputs": {"type": "integer", "minimum": 0},
        "raw_mcp_json_repetitions": {"type": "integer", "minimum": 0},
        "guarantee_wording_checks": {"type": "integer", "minimum": 0},
        "accurate_cooperative_guarantee_wording": {"type": "integer", "minimum": 0}
      }
    },
    "trialFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "failure_code", "detail"],
      "properties": {
        "trial_id": {"type": "string", "pattern": "^trial-[0-9]{6}$"},
        "failure_code": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "status",
        "target",
        "measured_value",
        "unit",
        "reason"
      ],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["measurement_pending", "passed", "failed"]},
        "target": {"type": "string", "minLength": 1},
        "measured_value": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_metrics_only",
        "prompt_text_retained",
        "file_contents_retained",
        "command_bodies_retained",
        "user_answer_bodies_retained",
        "driver_stderr_retained"
      ],
      "properties": {
        "aggregate_metrics_only": {"const": true},
        "prompt_text_retained": {"const": false},
        "file_contents_retained": {"const": false},
        "command_bodies_retained": {"const": false},
        "user_answer_bodies_retained": {"const": false},
        "driver_stderr_retained": {"const": false}
      }
    }
  }
}
