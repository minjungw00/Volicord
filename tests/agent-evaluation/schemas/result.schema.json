        "completion_claim_opportunities",
        "premature_completion_claims",
        "accepted_outcome_opportunities",
        "accepted_outcomes_surfaced",
        "rejected_outcome_opportunities",
        "rejected_outcomes_surfaced",
        "deferred_outcome_opportunities",
        "deferred_outcomes_surfaced",
        "expired_outcome_opportunities",
        "expired_outcomes_surfaced",
        "non_authorizing_outcome_opportunities",
        "false_authority_claims",
        "expired_resolution_instruction_opportunities",
        "expired_resolution_instructions",
        "shaping_recovery_opportunities",
        "correct_shaping_recoveries",
        "successor_user_action_opportunities",
        "successor_user_actions_created",
        "retained_authority_opportunities",
        "retained_authority_preserved",
        "application_owner_opportunities",
        "exact_application_owners",
        "superseded_history_opportunities",
        "superseded_history_action_instructions",
        "recovery_successor_acceptance_opportunities",
        "recovery_successor_acceptances",
        "valid_history_consistency_opportunities",
        "inconsistent_authority_claims",
        "stale_authority_explanation_opportunities",
        "correct_stale_authority_explanations",
        "stale_resolution_reuse_opportunities",
        "stale_accepted_resolution_reuses",
        "stale_disposition_opportunities",
        "exact_stale_dispositions",
        "stale_reauthorization_request_opportunities",
        "fresh_stale_user_actions_created",
        "implementation_invalidation_opportunities",
        "correct_implementation_invalidation_rejections"
      ],
      "properties": {
        "long_lived_repository_requests": {"type": "integer", "minimum": 0},
        "automatic_volicord_uses": {"type": "integer", "minimum": 0},
        "workflow_tool_selection_opportunities": {"type": "integer", "minimum": 0},
        "correct_workflow_tool_selections": {"type": "integer", "minimum": 0},
        "action_form_use_opportunities": {"type": "integer", "minimum": 0},
        "current_action_forms_used": {"type": "integer", "minimum": 0},
        "method_specific_form_opportunities": {"type": "integer", "minimum": 0},
        "method_specific_action_forms_used": {"type": "integer", "minimum": 0},
        "fixed_argument_opportunities": {"type": "integer", "minimum": 0},
        "exact_fixed_arguments_used": {"type": "integer", "minimum": 0},
        "wrong_method_mutation_opportunities": {"type": "integer", "minimum": 0},
        "wrong_method_speculative_mutations": {"type": "integer", "minimum": 0},
        "nullable_baseline_opportunities": {"type": "integer", "minimum": 0},
        "json_null_baselines_used": {"type": "integer", "minimum": 0},
        "schema_recovery_opportunities": {"type": "integer", "minimum": 0},
        "correct_discriminator_recoveries": {"type": "integer", "minimum": 0},
        "unrelated_cli_help_uses": {"type": "integer", "minimum": 0},
        "binary_schema_inspections": {"type": "integer", "minimum": 0},
        "raw_stdio_schema_probes": {"type": "integer", "minimum": 0},
        "source_schema_searches": {"type": "integer", "minimum": 0},
        "null_baseline_substitutions": {"type": "integer", "minimum": 0},
        "speculative_shaping_tool_calls": {"type": "integer", "minimum": 0},
        "argument_error_opportunities": {"type": "integer", "minimum": 0},
        "corruption_misdiagnoses": {"type": "integer", "minimum": 0},
        "replacement_required_opportunities": {"type": "integer", "minimum": 0},
        "replace_current_forms_selected": {"type": "integer", "minimum": 0},
        "keep_current_retry_loops": {"type": "integer", "minimum": 0},
        "invented_baseline_representations": {"type": "integer", "minimum": 0},
        "no_effect_replacement_opportunities": {"type": "integer", "minimum": 0},
        "false_replacement_success_claims": {"type": "integer", "minimum": 0},
        "persisted_baseline_corruption_opportunities": {"type": "integer", "minimum": 0},
        "stored_state_corruptions_reported": {"type": "integer", "minimum": 0},
        "corruption_user_input_misdiagnoses": {"type": "integer", "minimum": 0},
        "checkpoint_status_opportunities": {"type": "integer", "minimum": 0},
        "correct_checkpoint_creation_statuses": {"type": "integer", "minimum": 0},
        "user_action_status_opportunities": {"type": "integer", "minimum": 0},
        "correct_user_action_creation_statuses": {"type": "integer", "minimum": 0},
        "no_task_intake_opportunities": {"type": "integer", "minimum": 0},
        "correct_intakes": {"type": "integer", "minimum": 0},
